#!/usr/bin/env bash
# hub-install - set up a Linux host to run the fleet: the exe.dev hub, or any
# Ubuntu 24.04 machine (an EC2 or GCE instance, the old MacBook on Linux).
# Run it on the host, as the user the fleet will run as (sudo is used for
# packages). Safe to run again: each step checks before it changes anything.
#
# Usage:
#   bin/hub-install            tools and runtimes (pinned to the laptop's versions)
#   bin/hub-install --check    only report what is installed
#   bin/hub-install --litestream
#                              install only the pinned Litestream (Linux or macOS;
#                              checksums live in bin/litestream-pin.sh)
#   bin/hub-install --worker   a voyage VM's worker (bin/voyage-vm-setup runs it): no browser,
#                              no 1Password CLI, no herdr, no Litestream
#
# What it does NOT do (secrets and state stay manual and deliberate; see the
# vault plan fleet/plans/ops/exe-dev-hub-setup.md):
#   the 1Password token (... | bin/fleet-op-token --stdin), GitHub sign-in,
#   pi's provider logins, Tailscale's login, moving fleet/inbox/, the R2 keys
#   for backups (bin/fleet-backup).
set -euo pipefail

BUN_VERSION=1.4.0
NODE_VERSION=25.1.0
PI_VERSION=1.3.0
TREEHOUSE_VERSION=2.3.0
HERDR_VERSION=0.9.5
# Litestream v0.5.17, checksums for Linux and macOS: bin/litestream-pin.sh.
PI_EXTENSIONS=(pi-cursor-sdk@^0.4.0 pi-hermes-memory@^0.9.9 pi-jetbrains-junie-bridge@^1.4.0 pi-obsidian@^0.2.3)

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ "${1:-}" = --litestream ]; then
  exec "$ROOT/bin/litestream-pin.sh"
fi

WORKER=0
if [ "${1:-}" = --worker ]; then WORKER=1; shift; fi

[ "$(uname)" = Linux ] || { echo "error: hub-install is for Linux hosts (Litestream alone: bin/hub-install --litestream)" >&2; exit 2; }
case "$(uname -m)" in
  x86_64) ARCH=amd64; NODE_ARCH=x64; HERDR_ARCH=x86_64 ;;
  aarch64|arm64) ARCH=arm64; NODE_ARCH=arm64; HERDR_ARCH=aarch64 ;;
  *) echo "error: unsupported CPU $(uname -m)" >&2; exit 2 ;;
esac
LOCAL="$HOME/.local"
BIN="$LOCAL/bin"
mkdir -p "$BIN"
export PATH="$BIN:$LOCAL/node/bin:$HOME/.bun/bin:$PATH"

have() { command -v "$1" >/dev/null 2>&1; }
step() { printf '\n== %s\n' "$1"; }
ver() { "$@" 2>/dev/null | head -1 || true; }

if [ "${1:-}" = --check ]; then
  for c in bun node pi just treehouse herdr gh op tailscale google-chrome chromium sqlite3 rg; do
    printf '%-14s %s\n' "$c" "$(have "$c" && ver "$c" --version || echo missing)"
  done
  if [ "$WORKER" = 0 ]; then printf '%-14s %s\n' litestream "$(have litestream && ver litestream version || echo missing)"; fi
  exit 0
fi

step "packages and security updates"
sudo apt-get update -qq
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
  unattended-upgrades just sqlite3 unzip ripgrep fd-find python3-venv python3-pip ffmpeg \
  ca-certificates gnupg fonts-noto-color-emoji fonts-dejavu-core >/dev/null
sudo dpkg-reconfigure -f noninteractive unattended-upgrades >/dev/null 2>&1 || true

step "apt repositories: GitHub CLI, 1Password CLI, Tailscale"
sudo install -d -m 0755 /etc/apt/keyrings
if [ ! -f /etc/apt/sources.list.d/github-cli.list ]; then
  curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg >/dev/null
  echo "deb [arch=$ARCH signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list >/dev/null
fi
if [ "$WORKER" = 0 ] && [ ! -f /etc/apt/sources.list.d/1password.list ]; then
  curl -fsSL https://downloads.1password.com/linux/keys/1password.asc | sudo gpg --dearmor --yes -o /etc/apt/keyrings/1password-archive-keyring.gpg
  echo "deb [arch=$ARCH signed-by=/etc/apt/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$ARCH stable main" | sudo tee /etc/apt/sources.list.d/1password.list >/dev/null
fi
if [ ! -f /etc/apt/sources.list.d/tailscale.list ]; then
  curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/noble.noarmor.gpg | sudo tee /usr/share/keyrings/tailscale-archive-keyring.gpg >/dev/null
  curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/noble.tailscale-keyring.list | sudo tee /etc/apt/sources.list.d/tailscale.list >/dev/null
fi
sudo apt-get update -qq
pkgs=(gh tailscale)
[ "$WORKER" = 1 ] || pkgs+=(1password-cli)
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${pkgs[@]}" >/dev/null

step "a browser for screenshots (bin/fleet-shot)"
if [ "$WORKER" = 0 ] && ! have google-chrome && ! have chromium; then
  if [ "$ARCH" = amd64 ]; then
    curl -fsSL -o /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq /tmp/chrome.deb >/dev/null && rm -f /tmp/chrome.deb
  else
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq chromium-browser >/dev/null || echo "note: no Chromium package; set CHROME_PATH"
  fi
fi

step "Bun $BUN_VERSION"
if [ "$(ver bun --version)" != "$BUN_VERSION" ]; then
  z=bun-linux-$( [ "$ARCH" = amd64 ] && echo x64 || echo aarch64 )
  curl -fsSL -o /tmp/bun.zip "https://github.com/oven-sh/bun/releases/download/bun-v$BUN_VERSION/$z.zip"
  rm -rf /tmp/bun-unzip && unzip -q /tmp/bun.zip -d /tmp/bun-unzip && install -m 0755 "/tmp/bun-unzip/$z/bun" "$BIN/bun" && rm -rf /tmp/bun.zip /tmp/bun-unzip
fi

step "Node $NODE_VERSION"
if [ "$(ver node --version)" != "v$NODE_VERSION" ]; then
  t="node-v$NODE_VERSION-linux-$NODE_ARCH"
  curl -fsSL -o /tmp/node.tar.xz "https://nodejs.org/dist/v$NODE_VERSION/$t.tar.xz"
  curl -fsSL -o /tmp/node.sums "https://nodejs.org/dist/v$NODE_VERSION/SHASUMS256.txt"
  (cd /tmp && grep " $t.tar.xz\$" node.sums | sed "s/$t.tar.xz/node.tar.xz/" | sha256sum -c --quiet)
  rm -rf "$LOCAL/node" && mkdir -p "$LOCAL/node" && tar -xJf /tmp/node.tar.xz -C "$LOCAL/node" --strip-components=1 && rm -f /tmp/node.tar.xz /tmp/node.sums
fi

step "pi $PI_VERSION and its extensions"
if [ "$(ver pi --version)" != "$PI_VERSION" ]; then
  npm install -g --silent "@earendil-works/pi-coding-agent@$PI_VERSION" >/dev/null
fi
mkdir -p "$HOME/.pi/agent/npm"
if [ ! -d "$HOME/.pi/agent/npm/node_modules/pi-cursor-sdk" ]; then
  (cd "$HOME/.pi/agent/npm" && [ -f package.json ] || echo '{"name":"pi-extensions","private":true}' > package.json; npm install --silent "${PI_EXTENSIONS[@]}" >/dev/null)
fi

# exe.dev's image ships a pi extension that asks, on an agent's first turn, whether
# to use exe.dev's LLM integrations; a fleet agent cannot answer and exits. The
# fleet brings its own keys: record "no" (the extension's own preference file).
if [ -d "$HOME/.pi/agent/extensions/exe-dev" ] && [ ! -f "$HOME/.pi/agent/exe-dev-llm-integration.json" ]; then
  printf '{\n  "version": 1,\n  "useExeIntegration": false\n}\n' > "$HOME/.pi/agent/exe-dev-llm-integration.json"
fi

step "treehouse $TREEHOUSE_VERSION and herdr $HERDR_VERSION"
if [ "$(ver treehouse --version | grep -o '[0-9.]*$')" != "$TREEHOUSE_VERSION" ]; then
  f="treehouse-v$TREEHOUSE_VERSION-linux-$ARCH.tar.gz"
  base="https://github.com/kunchenguid/treehouse/releases/download/v$TREEHOUSE_VERSION"
  curl -fsSL -o "/tmp/$f" "$base/$f" && curl -fsSL -o /tmp/treehouse.sums "$base/checksums.txt"
  (cd /tmp && grep " $f\$" treehouse.sums | sha256sum -c --quiet)
  tar -xzf "/tmp/$f" -C /tmp treehouse && install -m 0755 /tmp/treehouse "$BIN/treehouse" && rm -f "/tmp/$f" /tmp/treehouse /tmp/treehouse.sums
fi
if [ "$WORKER" = 0 ] && [ "$(ver herdr --version | grep -o '[0-9.]*$')" != "$HERDR_VERSION" ]; then
  curl -fsSL -o "$BIN/herdr" "https://github.com/ogulcancelik/herdr/releases/download/v$HERDR_VERSION/herdr-linux-$HERDR_ARCH" && chmod 0755 "$BIN/herdr"
fi

step "Litestream (hub backups to R2; bin/fleet-backup)"
if [ "$WORKER" = 0 ]; then
  "$ROOT/bin/litestream-pin.sh"
fi

step "PATH for logins and services"
line='export PATH="$HOME/.local/bin:$HOME/.local/node/bin:$PATH"'
grep -qxF "$line" "$HOME/.profile" 2>/dev/null || echo "$line" >> "$HOME/.profile"
grep -qxF "$line" "$HOME/.bashrc" 2>/dev/null || echo "$line" >> "$HOME/.bashrc"

step "done"
"$0" --check
