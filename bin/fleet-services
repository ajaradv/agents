#!/usr/bin/env bash
# fleet-services - run the fleet node and the dashboard as background
# services (launchd LaunchAgents on macOS, systemd units on Linux): they
# start at login (Linux: at boot) and restart if they die.
#
# Usage:
#   bin/fleet-services install     write ~/Library/LaunchAgents/*.plist and start both
#   bin/fleet-services uninstall   stop both and remove the plists
#   bin/fleet-services status      show each job and its pid
#   bin/fleet-services restart     restart both (agents stop; sessions resume on the next message)
#
# The node job (com.fleet.node) owns the agents; launchd restarts it when it
# exits, including when the dashboard stops a node that runs older code. The
# dashboard job (com.fleet.dashboard) serves the page; it finds the running node
# instead of starting its own.
#
# Logs: fleet/inbox/.node/node.log and fleet/inbox/.node/dashboard.log.
# PATH is captured from the shell that runs install, so bun, pi, python3, and uv
# resolve the same way they do in your terminal. Re-run install after moving
# those tools.
#
# Testing overrides (not for daily use): FLEET_SERVICE_SUFFIX names a second pair
# of jobs (com.fleet.node.<suffix>), and DASHBOARD_PORT / FLEET_INBOX / ALICE_VAULT
# are passed through to both jobs when set.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SUFFIX="${FLEET_SERVICE_SUFFIX:-}"
LABEL_NODE="com.fleet.node${SUFFIX:+.$SUFFIX}"
LABEL_DASH="com.fleet.dashboard${SUFFIX:+.$SUFFIX}"
LABEL_BROWSER="com.fleet.browser${SUFFIX:+.$SUFFIX}"
AGENTS_DIR="$HOME/Library/LaunchAgents"
INBOX="${FLEET_INBOX:-$ROOT/fleet/inbox}"
LOGS="$INBOX/.node"
PORT="${DASHBOARD_PORT:-8787}"
DOMAIN="gui/$(id -u)"
BUN="$(command -v bun || true)"

die() { printf 'error: %s\n' "$1" >&2; exit 1; }
xml() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

env_block() { # extra KEY=VALUE pairs for this job
  printf '    <key>EnvironmentVariables</key>\n    <dict>\n'
  printf '      <key>PATH</key><string>%s</string>\n' "$(xml "$PATH")"
  for kv in "$@"; do printf '      <key>%s</key><string>%s</string>\n' "${kv%%=*}" "$(xml "${kv#*=}")"; done
  printf '      <key>HOME</key><string>%s</string>\n' "$(xml "$HOME")"
  for k in DASHBOARD_PORT FLEET_INBOX ALICE_VAULT FLEET_NODE_PORT FLEET_TAILNET_USERS; do
    if [ -n "${!k:-}" ]; then printf '      <key>%s</key><string>%s</string>\n' "$k" "$(xml "${!k}")"; fi
  done
  printf '    </dict>\n'
}

plist() { # label, script, log, [KEY=VALUE ...]
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key><string>$1</string>
    <key>ProgramArguments</key>
    <array><string>$(xml "$BUN")</string><string>run</string><string>$(xml "$ROOT/$2")</string></array>
    <key>WorkingDirectory</key><string>$(xml "$ROOT")</string>
$(env_block "${@:4}")
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>5</integer>
    <key>ProcessType</key><string>Interactive</string>
    <key>StandardOutPath</key><string>$(xml "$LOGS/$3")</string>
    <key>StandardErrorPath</key><string>$(xml "$LOGS/$3")</string>
  </dict>
</plist>
EOF
}

stop_job() { # bootout, then wait until launchd has really unloaded it (bootstrap fails with EIO otherwise)
  launchctl bootout "$DOMAIN/$1" 2>/dev/null || true
  for _ in $(seq 1 40); do
    launchctl print "$DOMAIN/$1" >/dev/null 2>&1 || return 0
    sleep 0.25
  done
}

start_job() { # bootstrap with a few retries
  for _ in 1 2 3 4 5; do
    launchctl bootstrap "$DOMAIN" "$AGENTS_DIR/$1.plist" 2>/dev/null && return 0
    sleep 1
  done
  launchctl bootstrap "$DOMAIN" "$AGENTS_DIR/$1.plist"
}

# ---------------------------------------------------------------- Linux (the exe.dev hub)
# systemd system units (run as this user) instead of LaunchAgents:
# fleet-node and fleet-dashboard, started at boot and restarted if they die.
# System units, not user units: an SSH session on the hub has no user manager.
if [ "$(uname)" = Linux ]; then
  UNITS=/etc/systemd/system
  U_NODE="fleet-node${SUFFIX:+-$SUFFIX}"
  U_DASH="fleet-dashboard${SUFFIX:+-$SUFFIX}"
  U_BROWSER="fleet-browser${SUFFIX:+-$SUFFIX}"
  unit() { # name, script, log, description, [KEY=VALUE ...]
    printf '[Unit]\nDescription=%s\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\n' "$4"
    printf 'User=%s\nWorkingDirectory=%s\nExecStart=%s run %s\n' "$(id -un)" "$ROOT" "$BUN" "$ROOT/$2"
    printf 'Environment=PATH=%s\nEnvironment=HOME=%s\n' "$PATH" "$HOME"
    for kv in "${@:5}"; do printf 'Environment=%s\n' "$kv"; done
    for k in DASHBOARD_PORT FLEET_INBOX ALICE_VAULT FLEET_NODE_PORT FLEET_TAILNET_USERS FLEET_LAPTOP_URL; do
      if [ -n "${!k:-}" ]; then printf 'Environment=%s=%s\n' "$k" "${!k}"; fi
    done
    printf 'Restart=always\nRestartSec=5\nStandardOutput=append:%s\nStandardError=append:%s\n\n[Install]\nWantedBy=multi-user.target\n' "$LOGS/$3" "$LOGS/$3"
  }
  sc() { sudo systemctl "$@"; }
  case "${1:-}" in
    install)
      [ -n "$BUN" ] || die "bun is not on PATH"
      mkdir -p "$LOGS"
      unit "$U_NODE" dashboard/node.ts node.log "Fleet node (agents, routines, orders)" | sudo tee "$UNITS/$U_NODE.service" >/dev/null
      unit "$U_DASH" dashboard/server.ts dashboard.log "Fleet dashboard" FLEET_NODE_SPAWN=0 | sudo tee "$UNITS/$U_DASH.service" >/dev/null
      unit "$U_BROWSER" dashboard/browser.ts browser.log "Fleet shared browser (one Chrome for every screenshot)" | sudo tee "$UNITS/$U_BROWSER.service" >/dev/null
      sc daemon-reload
      # restart, not just enable --now: a running service would keep its old settings (FLEET_LAPTOP_URL on 2026-10-22).
      for u in "$U_NODE" "$U_DASH" "$U_BROWSER"; do sc enable "$u.service" >/dev/null 2>&1; sc restart "$u.service" && echo "started $u"; done
      ;;
    uninstall)
      for u in "$U_BROWSER" "$U_DASH" "$U_NODE"; do sc disable --now "$u.service" 2>/dev/null; sudo rm -f "$UNITS/$u.service"; echo "removed $u"; done
      sc daemon-reload
      ;;
    restart)
      for u in "$U_NODE" "$U_DASH" "$U_BROWSER"; do sc restart "$u.service" && echo "restarted $u"; done
      ;;
    status)
      for u in "$U_NODE" "$U_DASH" "$U_BROWSER"; do
        if sc is-active --quiet "$u.service"; then echo "$u: running (pid $(sc show -p MainPID --value "$u.service"))"
        elif [ -f "$UNITS/$u.service" ]; then echo "$u: installed, not running"
        else echo "$u: not installed"; fi
      done
      ;;
    *)
      awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
      exit 2
      ;;
  esac
  exit 0
fi

case "${1:-}" in
  install)
    [ -n "$BUN" ] || die "bun is not on PATH"
    if lsof -tiTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1 && ! launchctl print "$DOMAIN/$LABEL_DASH" >/dev/null 2>&1; then
      die "port $PORT is in use (a dashboard running in a terminal?). Stop it first, then run install again."
    fi
    mkdir -p "$AGENTS_DIR" "$LOGS"
    # launchd owns the node: the dashboard job never starts one itself (FLEET_NODE_SPAWN=0),
    # so the two can never race for the port at login or after a restart.
    for pair in "$LABEL_NODE:dashboard/node.ts:node.log:" "$LABEL_DASH:dashboard/server.ts:dashboard.log:FLEET_NODE_SPAWN=0" "$LABEL_BROWSER:dashboard/browser.ts:browser.log:"; do
      IFS=: read -r label script log extra <<<"$pair"
      plist "$label" "$script" "$log" ${extra:+"$extra"} > "$AGENTS_DIR/$label.plist"
      plutil -lint -s "$AGENTS_DIR/$label.plist" || die "bad plist for $label"
      stop_job "$label"
      start_job "$label"
      echo "started $label"
    done
    ;;
  uninstall)
    for label in "$LABEL_BROWSER" "$LABEL_DASH" "$LABEL_NODE"; do
      stop_job "$label"
      rm -f "$AGENTS_DIR/$label.plist"
      echo "removed $label"
    done
    ;;
  restart)
    for label in "$LABEL_NODE" "$LABEL_DASH" "$LABEL_BROWSER"; do launchctl kickstart -k "$DOMAIN/$label" && echo "restarted $label"; done
    ;;
  status)
    for label in "$LABEL_NODE" "$LABEL_DASH" "$LABEL_BROWSER"; do
      if launchctl print "$DOMAIN/$label" >/dev/null 2>&1; then
        pid=$(launchctl print "$DOMAIN/$label" | awk '/^\tpid = /{print $3}')
        echo "$label: running${pid:+ (pid $pid)}"
      else
        echo "$label: not installed"
      fi
    done
    ;;
  *)
    awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
    exit 2
    ;;
esac
