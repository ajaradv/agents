#!/usr/bin/env bash
# survey - fresh reviewers on other models check a vault plan or spec (or flesh out a raw idea),
# from the laptop. Pushes the vault, has the hub pull it, then runs the review on the hub (the hub
# holds the journal, the node and the reviewers' keys) and waits for the review file.
#
# Usage:
#   bin/survey <vault path> --writer <model> [--mode review|brainstorm] [--depth skip|light|full] [--lenses +comprehension] [--ship S]
#
# Example: bin/survey fleet/plans/feature/x.md --writer anthropic/claude-opus-5.5
#
# The review lands in the vault at fleet/reviews/<slug>/review-<n>.md on the hub; this script then
# syncs the hub's vault and pulls it here. Resolve it under "## Resolution", as the Architect does.
# Exits non-zero when the review or either sync fails.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[ $# -gt 0 ] || { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

"$ROOT/bin/vault-sync"
"$ROOT/bin/hub" vault-sync
rc=0
"$ROOT/bin/hub" fleet-axi review "$@" || rc=$?
# Sync even after a failed review: the triage note it wrote should reach the laptop too.
"$ROOT/bin/hub" vault-sync || { echo "survey: the hub's vault-sync failed; the review is on the hub but not here" >&2; exit 1; }
"$ROOT/bin/vault-sync" || { echo "survey: vault-sync failed; the review is not pulled" >&2; exit 1; }
exit "$rc"
