#!/usr/bin/env python3
"""Launch an agent from agents/<id>/agent.yaml (Pi harness only in v1)."""
from __future__ import annotations

import json
import os
import re
import signal
import stat
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONFIG = ROOT / "agents" / "config.yaml"
FLEET_HOME = ROOT / "fleet" / "home"

# Keys exported from fleet/home/.env when not already in the environment (env wins).
ENV_ALLOWLIST = frozenset(
    {
        "TYPESAFE_API_KEY",
        "DEEPSEEK_API_KEY",
        "OPENROUTER_API_KEY",
        "HF_API_KEY",
        "HF_TOKEN",
        "CURSOR_API_KEY",
        "ANTHROPIC_API_KEY",
        "GEMINI_API_KEY",
    }
)


def parse_simple_yaml(path: Path) -> dict:
    """Parse flat agent.yaml files (scalars, lists, one-level nested maps).

    `maneuvers:` is the one two-level map (name -> its fields). Lines nested
    deeper than the parser follows are skipped, never written to the top level.
    """
    data: dict = {}
    list_key: str | None = None
    nested: dict | None = None
    nested_key: str | None = None
    deep: dict | None = None  # a maneuver's fields (indent 4)
    deep_key: str | None = None

    def scalar(s: str):
        s = s.strip()
        if s in ("null", "~", ""):
            return None
        if s.startswith('"') and s.endswith('"'):
            return s[1:-1]
        if s == "{}":
            return {}
        if s.startswith("[") and s.endswith("]"):
            inner = s[1:-1].strip()
            return [] if not inner else [x.strip().strip('"') for x in inner.split(",")]
        return s

    for raw in path.read_text().splitlines():
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        indent = len(raw) - len(raw.lstrip())
        line = raw.strip()
        if deep is not None and indent >= 4:
            if line.startswith("- "):
                if deep_key and isinstance(deep.get(deep_key), list):
                    deep[deep_key].append(scalar(line[2:]))
            elif ":" in line:
                k, _, r = line.partition(":")
                deep_key = k.strip()
                deep[deep_key] = [] if not r.strip() else scalar(r)
            continue
        deep = None
        deep_key = None
        if data.get("maneuvers") is not None and nested is data["maneuvers"] and indent >= 2:
            if not line.startswith("- ") and ":" in line:
                k, _, r = line.partition(":")
                if not r.strip():
                    deep = {}
                    nested[k.strip()] = deep
            continue
        if line.startswith("- "):
            item = scalar(line[2:])
            if nested is not None and nested_key:
                nested.setdefault(nested_key, [])
                if isinstance(nested[nested_key], list):
                    nested[nested_key].append(item)
            elif list_key:
                data.setdefault(list_key, [])
                if isinstance(data[list_key], list):
                    data[list_key].append(item)
            continue
        if ":" not in line:
            continue
        key, _, rest = line.partition(":")
        key = key.strip()
        rest = rest.strip()
        if indent == 0:
            nested = None
            nested_key = None
            list_key = None
        if rest == "":
            if indent == 0:
                if key in ("authority", "env", "crew_models", "crew_budgets", "checks", "gates", "maneuvers"):
                    data[key] = {}
                    nested = data[key]
                    nested_key = None
                else:
                    data[key] = []
                    list_key = key
            elif nested is not None and indent >= 2:
                nested[key] = []
                nested_key = key
            continue
        val = scalar(rest)
        if nested is not None and indent >= 2:
            nested[key] = val
        elif indent == 0:
            data[key] = val
            list_key = None
    return data


def load_npm_registry() -> dict:
    if not CONFIG.exists():
        return {}
    reg: dict[str, dict] = {}
    current: str | None = None
    in_npm = False
    for raw in CONFIG.read_text().splitlines():
        line = raw.strip()
        if line == "npm_extensions:":
            in_npm = True
            continue
        if not in_npm:
            continue
        if not line or line.startswith("#"):
            continue
        if line.startswith("types:") and current:
            reg[current]["types"] = re.findall(
                r"assistant|orchestrator|crew", line.split(":", 1)[1]
            )
            continue
        if line.startswith("package:") and current:
            reg[current]["package"] = line.split(":", 1)[1].strip()
            continue
        if line.endswith(":") and not line.startswith(" "):
            current = line[:-1].strip()
            reg[current] = {"types": [], "package": f"npm:pi-{current}"}
        elif raw and not raw.startswith(" ") and not raw.startswith("\t"):
            break
    return reg


def extension_allowed(name: str, agent_type: str, npm_reg: dict) -> tuple[bool, str]:
    if name in npm_reg:
        entry = npm_reg[name]
        types = entry.get("types") or []
        pkg = entry.get("package") or f"npm:pi-{name}"
        if agent_type not in types:
            return False, pkg
        return True, pkg
    ext = ROOT / "extensions" / f"{name}.ts"
    if ext.is_file():
        return True, str(ext)
    return False, name


def fleet_inbox_root() -> Path:
    raw = os.environ.get("FLEET_INBOX")
    if raw:
        return Path(raw).expanduser().resolve()
    return (ROOT / "fleet" / "inbox").resolve()


def _read_env_file_contents(path: Path, timeout_sec: float = 2.0) -> str:
    try:
        st = path.stat()
    except OSError:
        return ""
    if stat.S_ISFIFO(st.st_mode) or stat.S_ISSOCK(st.st_mode):
        try:
            r = subprocess.run(
                ["cat", str(path)],
                capture_output=True,
                text=True,
                timeout=timeout_sec,
            )
            return r.stdout or ""
        except (subprocess.TimeoutExpired, OSError):
            return ""
    if not stat.S_ISREG(st.st_mode):
        return ""
    try:
        return path.read_text()
    except OSError:
        return ""


def _apply_hf_key_alias() -> None:
    api = os.environ.get("HF_API_KEY", "").strip()
    tok = os.environ.get("HF_TOKEN", "").strip()
    if api and not tok:
        os.environ["HF_TOKEN"] = api
    elif tok and not api:
        os.environ["HF_API_KEY"] = tok


def parse_env_file(path: Path) -> dict[str, str]:
    """Last assignment wins; # comments and blank lines ignored."""
    out: dict[str, str] = {}
    text = _read_env_file_contents(path)
    # The secrets manager's pipe serves one reader at a time; an empty read is
    # usually a collision, so try again before launching without keys.
    for _ in range(2):
        if text.strip():
            break
        time.sleep(0.5)
        text = _read_env_file_contents(path)
    if not text:
        if path.exists():
            print(f"launch: {path} gave no keys; provider calls may fail", file=sys.stderr)
        return out
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].strip()
        if "=" not in line:
            continue
        key, _, val = line.partition("=")
        key = key.strip()
        val = val.strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] in ('"', "'"):
            val = val[1:-1]
        if key:
            out[key] = val
    return out


def apply_fleet_home_env() -> None:
    env_path = FLEET_HOME / ".env"
    for key, val in parse_env_file(env_path).items():
        if key in ENV_ALLOWLIST and key not in os.environ and val:
            os.environ[key] = val
    _apply_hf_key_alias()


def build_role_prompt(role_file: Path, extra_block: str, extra_prompt_paths: list[Path] | None = None) -> Path:
    body = role_file.read_text()
    for p in extra_prompt_paths or []:
        if p.is_file():
            body = body.rstrip() + "\n\n---\n\n" + p.read_text().strip() + "\n"
        else:
            print(f"warning: extra_prompt missing {p}", file=sys.stderr)
    if extra_block:
        body = body.rstrip() + "\n\n" + extra_block.strip() + "\n"
    tmp = tempfile.NamedTemporaryFile(
        mode="w", suffix=".md", prefix="role-", delete=False, encoding="utf-8"
    )
    tmp.write(body)
    tmp.close()
    return Path(tmp.name)


DASHBOARD_CHAT_BLOCK = (
    "## Dashboard captain chat (this turn)\n\n"
    "You are answering a **headless dashboard message** from the captain (not the interactive TUI composer). "
    "Reply in **plain text** suitable for the dashboard chat log. "
    "When you finish, your reply text is captured from stdout; you do not need to append the jsonl file yourself in print mode.\n\n"
    "**The captain can answer questions.** This chat is a conversation: when a decision is the captain's (direction, naming, "
    "scope, a pick between options) or the request is ambiguous, call the **`ask_captain`** tool with 2-5 concrete options per "
    "question, then end your turn. The questions appear in the dashboard as clickable choices and the answer comes back as the "
    "captain's next message. Do not choose a default for a captain decision because you are in a headless turn; that is what "
    "`ask_captain` is for. Settle facts you can check yourself instead of asking.\n\n"
    "**Show, don't paste paths.** When the captain should look at something (images, a page, a table, a local URL), "
    "call **`canvas_show`**; it appears on the canvas next to this chat.\n"
)


DASHBOARD_RPC_BLOCK = (
    "## Dashboard captain chat (live session)\n\n"
    "The captain talks to you from the fleet dashboard, which runs you as one long-lived session. "
    "Your messages stream into the chat drawer as you write them; reply in **plain text**. "
    "The captain can send more messages while you work (they arrive between your steps) and can stop you.\n\n"
    "**Ask instead of assuming.** When a decision is the captain's (direction, naming, scope, a pick between options) "
    "or the request is ambiguous, call **`ask_captain`** with 2-5 concrete options per question. It shows clickable "
    "choices in the dashboard and **waits for the answer**, then you continue in the same turn. Settle facts you can "
    "check yourself instead of asking.\n\n"
    "**Show, don't paste paths.** When the captain should look at something (images, comps, screenshots, a page, a "
    "table, a local URL such as a decision board or the dev server), call **`canvas_show`**. It appears on the canvas "
    "next to this chat.\n\n"
    "**Your first line may be spoken aloud.** With voice on, the dashboard reads the opening of each reply and stops at "
    "the first list, table, or code block. Make the first line the answer or a short acknowledgement a person would say, "
    "and keep the details below it.\n"
)

# Set by rpc_main before prepare_pi_launch so the prompt matches the runtime.
RUNTIME = "headless"


def dashboard_chat_block() -> str:
    return DASHBOARD_RPC_BLOCK if RUNTIME == "rpc" else DASHBOARD_CHAT_BLOCK


# What a crewmate's VM reaches when its ship names no vm_allow (keep in step with
# DEFAULT_VM_ALLOW in dashboard/lib/fleet-layers.ts): package registries and GitHub over HTTPS.
DEFAULT_VM_ALLOW = [
    "pypi.org", "files.pythonhosted.org", "registry.npmjs.org", "crates.io", "static.crates.io",
    "index.crates.io", "github.com", "codeload.github.com", "objects.githubusercontent.com",
    "raw.githubusercontent.com",
]


def voyage_worktree(ship_id: str) -> dict | None:
    """The open voyage's worktree for a fleet-crewed ship (written by dashboard/lib/voyage-worktree.ts), or None."""
    try:
        w = json.loads((fleet_inbox_root() / "ships" / ship_id / "worktree.json").read_text())
    except (OSError, ValueError):
        return None
    return w if isinstance(w, dict) and Path(str(w.get("path", ""))).is_dir() else None


def vm_env(ship: dict, agent_id: str, inbox: Path, agent: dict | None = None) -> dict[str, str]:
    """Environment for the fleet Gondolin extension (extensions/gondolin), for a ship with `isolation: vm`.

    The agent's `vm_image` (agent.yaml) picks the image: "browser" (R4e: Chromium and the shot command,
    more memory) when that image is built, else the plain fleet image. Its skill folders are mounted
    read-only at their host paths, so the model can read the skills pi lists for it.
    """
    agent = agent or {}
    image_kind = str(agent.get("vm_image") or "")
    allow = ship.get("vm_allow")
    hosts = DEFAULT_VM_ALLOW if allow is None else [str(h).lower() for h in (allow or [])]
    ship_mem = inbox / "ships" / str(ship.get("id") or "") / "memory"
    ship_mem.mkdir(parents=True, exist_ok=True)
    # Per crewmate, not per ship: two VMs installing hooks into one folder at once could corrupt it.
    cache = inbox / agent_id / "cache"
    cache.mkdir(parents=True, exist_ok=True)
    env = {
        "FLEET_VM": "1",
        "FLEET_VM_ALLOW": ",".join(hosts),
        "FLEET_VM_MEMORY": str(inbox / agent_id / "memory"),
        "FLEET_VM_SHIP_MEMORY": str(ship_mem),
        "FLEET_VM_CACHE": str(cache),
    }
    ro = vm_skill_dirs(agent)
    if ro:
        env["FLEET_VM_RO_MOUNTS"] = os.pathsep.join(ro)
    images = ROOT / "fleet" / "home" / "gondolin"
    browser = images / "browser-assets"
    if image_kind == "browser" and (browser / "manifest.json").is_file():
        env["FLEET_VM_IMAGE"] = str(browser)
        env["FLEET_VM_BROWSER"] = "1"
        # Chromium alongside node and git: 1 GB is tight.
        env["FLEET_VM_RAM"] = "2G"
    elif (images / "fleet-assets" / "manifest.json").is_file():
        env["FLEET_VM_IMAGE"] = str(images / "fleet-assets")
        if image_kind == "browser":
            print(f"{agent_id}: the browser VM image is not built (bin/fleet-vm-image browser); using the plain image", file=sys.stderr)
    return env


def vm_skill_dirs(agent: dict) -> list[str]:
    """Skill folders a VM crewmate's pi lists (its skill_paths, and the global skill folders pi discovers)."""
    dirs = [ROOT / str(rel) for rel in agent.get("skill_paths") or []]
    if str(agent.get("discover_skills")).lower() != "false":
        dirs += [Path.home() / ".agents" / "skills", Path.home() / ".pi" / "agent" / "skills"]
    return [str(d.resolve()) for d in dirs if d.is_dir()]


def launchable_maneuvers(ship: dict, role: str, ship_path: Path) -> list[str]:
    """Maneuvers this role may launch itself (dashboard/lib/maneuvers.ts decides; this only picks who gets the tool).

    Declared ones whose `by` names the role (default: the lead), never `go: true`
    ones; for the lead, also the repo's ADWs nobody declared.
    """
    decls = ship.get("maneuvers") if isinstance(ship.get("maneuvers"), dict) else {}
    names: list[str] = []
    named: set[str] = set()
    for name, m in decls.items():
        if not isinstance(m, dict):
            continue
        named.update({str(name), str(m.get("adw") or "")})
        by = m.get("by") or ["lead"]
        by = [by] if isinstance(by, str) else [str(r) for r in by]
        if m.get("go") not in (True, "true") and role in by:
            names.append(str(name))
    if role == "lead":
        adws = ship_path / "adws"
        found = sorted(p.stem for p in adws.glob("adw_*.py")) if adws.is_dir() else []
        names += [a for a in found if a not in named]
    return names


def ships_dir() -> Path:
    raw = os.environ.get("FLEET_SHIPS_DIR")
    return Path(raw).expanduser() if raw else ROOT / "fleet" / "ships"


def merge_config(base, overlay):
    """Overlay on top of base (dashboard/lib/ship-config.ts): maps merge key by key, the rest replaces, None removes."""
    if not isinstance(base, dict) or not isinstance(overlay, dict):
        return overlay
    out = dict(base)
    for k, v in overlay.items():
        if v is None:
            out.pop(k, None)
        else:
            out[k] = merge_config(base.get(k), v)
    return out


def ship_config(y: Path) -> dict:
    """A ship's merged config: the committed base (fleet/ships) plus its live overlay (fleet/home/ships).

    The node writes the merged view as JSON (fleet/inbox/.node/ships/<ship>.json);
    it is used while it is newer than both files, else the two are merged here.
    """
    raw = os.environ.get("FLEET_SHIP_OVERLAY_DIR")
    overlay = (Path(raw).expanduser() if raw else FLEET_HOME / "ships") / y.name
    merged_json = fleet_inbox_root() / ".node" / "ships" / f"{y.stem}.json"
    try:
        newest = max(y.stat().st_mtime, overlay.stat().st_mtime if overlay.is_file() else 0)
        if merged_json.is_file() and merged_json.stat().st_mtime >= newest:
            data = json.loads(merged_json.read_text())
            if isinstance(data, dict):
                return data
    except (OSError, ValueError):
        pass
    base = parse_simple_yaml(y)
    return merge_config(base, parse_simple_yaml(overlay)) if overlay.is_file() else base


def resolve_crewmate(agent_id: str) -> tuple[dict, dict] | None:
    """`<ship>-<role>` for a role listed under `crew:` in fleet/ships/<ship>.yaml.

    Returns (ship, role agent.yaml merged with the ship's overrides), or None.
    A crewmate is the role's template deployed aboard one ship: cwd is the ship's
    repo, the session is persistent and lives in fleet/inbox/<ship>-<role>/.
    """
    for y in sorted(ships_dir().glob("*.yaml")):
        ship = ship_config(y)
        sid = str(ship.get("id") or y.stem)
        if not agent_id.startswith(sid + "-"):
            continue
        role = agent_id[len(sid) + 1 :]
        if role not in [str(r) for r in ship.get("crew") or []]:
            continue
        template = ROOT / "agents" / role / "agent.yaml"
        if not template.is_file() or not ship.get("path"):
            return None
        agent = parse_simple_yaml(template)
        model = (ship.get("crew_models") or {}).get(role)
        if model:
            agent["model"] = model
        agent["runtime"] = "rpc"
        agent["dashboard_session"] = "persistent"
        ship["id"] = sid
        return ship, agent
    return None


def load_agent(agent_id: str) -> tuple[dict, dict | None] | None:
    """(agent.yaml, ship or None) for a registered agent or a ship crewmate."""
    path = ROOT / "agents" / agent_id / "agent.yaml"
    if path.is_file():
        return parse_simple_yaml(path), None
    crew = resolve_crewmate(agent_id)
    if crew:
        return crew[1], crew[0]
    return None


# A model's provider and the key it needs from fleet/home/.env.
PROVIDER_KEYS = {"cursor": "CURSOR_API_KEY", "deepseek": "DEEPSEEK_API_KEY", "openrouter": "OPENROUTER_API_KEY", "anthropic": "ANTHROPIC_API_KEY", "google": "GEMINI_API_KEY"}
# Every secret the fleet hands out (R4c): an assistant keeps only the ones it needs.
SECRET_KEYS = ("TYPESAFE_API_KEY", "DEEPSEEK_API_KEY", "OPENROUTER_API_KEY", "HF_API_KEY", "HF_TOKEN", "CURSOR_API_KEY", "ANTHROPIC_API_KEY", "GEMINI_API_KEY")


def keys_needed(agent: dict) -> set[str]:
    """The provider keys of the agent's model and backup model, plus any it lists under `keys:`."""
    need: set[str] = set()
    for m in (agent.get("model"), agent.get("fallback_model")):
        if isinstance(m, str) and m:
            key = PROVIDER_KEYS.get(m.split("/", 1)[0])
            if key:
                need.add(key)
    for k in agent.get("keys") or []:
        if str(k) in SECRET_KEYS:
            need.add(str(k))
    if "HF_API_KEY" in need or "HF_TOKEN" in need:
        need |= {"HF_API_KEY", "HF_TOKEN"}
    return need


def restrict_keys(agent: dict) -> list[str]:
    """Drop every secret this agent does not need from the environment pi inherits; returns what was dropped."""
    need = keys_needed(agent)
    dropped = [k for k in SECRET_KEYS if k in os.environ and k not in need]
    for k in dropped:
        del os.environ[k]
    return dropped


def memory_block(agent_id: str, inbox: Path) -> str:
    """File-based memory for every assistant: static paths (cache-safe), read on demand."""
    mem = inbox / agent_id / "memory"
    vault = Path(os.environ.get("ALICE_VAULT", "/Users/avega/Workspace/brain")).expanduser()
    return (
        "\n## Memory (files, read on demand)\n\n"
        f"- **Your memory folder:** `{mem}`\n"
        "  - `state.md`: written automatically after every compaction, a handoff of everything before it. "
        "**When this session's history is empty or starts with a summary, read `state.md` and `plan.md` first.**\n"
        "  - `plan.md`: your current plan and open threads; keep it up to date when the plan changes.\n"
        "  - `notes.md`: durable notes worth keeping across sessions (decisions, facts you had to look up).\n"
        f"- **The captain's profile (shared, in the vault):** `{vault / 'fleet' / 'captain.md'}`: preferences and standing instructions. "
        "Read it when a preference matters; Alice keeps it current.\n"
        "Do not paste these files into replies; read them when needed, write them with your file tools.\n"
    )


def _read_capped(path: Path, cap: int) -> str:
    try:
        text = path.read_text().strip()
    except OSError:
        return ""
    return text if len(text) <= cap else text[:cap].rstrip() + f"\n\n[... cut at {cap} characters; read the file for the rest]"


def crew_memory_block(agent_id: str, ship_id: str, inbox: Path, isolated: bool, wt: dict | None) -> str:
    """Tiered memory for a crewmate (dashboard/lib/crew-memory.ts), most stable first so the
    top stays a cached prefix and only the bottom (this voyage) changes between voyages."""
    ship_mem = inbox / "ships" / ship_id / "memory"
    own = inbox / agent_id / "memory"
    # Paths as the crewmate's tools see them: inside a VM, the folders are mounted.
    ship_p = Path("/ship-memory") if isolated else ship_mem
    own_p = Path("/memory") if isolated else own
    project = _read_capped(ship_mem / "project.md", 6000)
    notes = _read_capped(own / "notes.md", 3000)
    voyage = _read_capped(ship_mem / "voyage.md", 4000)
    out = [
        f"\n## Project memory ({ship_id}; shared by the crew, kept across voyages)\n",
        f"File: `{ship_p / 'project.md'}`. Lasting knowledge about this project: conventions, commands, gotchas, decisions. "
        "Add a line when you learn something the next voyage should know; prune what stops being true. Never secrets.\n",
        (project or "(empty so far)") + "\n",
        "\n## Your notes (kept across voyages)\n",
        f"File: `{own_p / 'notes.md'}`. Your own durable notes.\n",
        (notes or "(empty so far)") + "\n",
        "\n## Memory rules\n",
        f"- `{own_p / 'plan.md'}` (your plan) and `{own_p / 'state.md'}` (written on compaction) belong to the current voyage and are cleared when it ends.\n",
        f"- The captain's profile (shared, in the vault): `{Path(os.environ.get('ALICE_VAULT', '/Users/avega/Workspace/brain')).expanduser() / 'fleet' / 'captain.md'}`.\n",
        "- When your history is empty or starts with a summary, read `plan.md` and `state.md` if they exist.\n",
        "\n## This voyage (discarded at dock)\n",
    ]
    if voyage:
        if wt:
            out.append(
                f"- Work in the voyage worktree (your cwd), on branch `{wt.get('branch', '')}`; never in the ship's repo folder (the captain's checkout). Never push.\n"
            )
        out.append(
            f"- Scratchpad, shared by the crew: `{ship_p / 'voyage.md'}`. Write progress, decisions, and open questions there. "
            "At dock it is archived into the voyage record and cleared; move anything worth keeping to project memory before then.\n\n"
        )
        out.append(voyage + "\n")
    else:
        out.append("No voyage under sail. Wait for one; do not start work on your own.\n")
    return "".join(out)


def record_running_model(agent_id: str, configured: object, chosen: object) -> None:
    """fleet/inbox/<id>/model-running.json: the model this launch uses, so the
    dashboard can show when an agent is on its backup."""
    try:
        d = fleet_inbox_root() / agent_id
        d.mkdir(parents=True, exist_ok=True)
        (d / "model-running.json").write_text(json.dumps({
            "model": chosen,
            "configured": configured,
            "backup": bool(chosen and configured and chosen != configured),
            "reason": LAST_FALLBACK_REASON if chosen != configured else "",
            "at": datetime.now(timezone.utc).isoformat(),
        }) + "\n")
    except OSError:
        pass


LAST_FALLBACK_REASON = ""


def model_with_fallback(model: object, fallback: object, agent_id: str) -> object:
    """The agent's model, or its fallback_model when the model cannot work today:
    its provider key is missing, or the fleet node recorded a billing, auth, or
    repeated stream failure on it today (fleet/inbox/<id>/model-fallback.json, written by the
    agent host; it lapses at midnight)."""
    if not (isinstance(model, str) and isinstance(fallback, str) and fallback):
        return model
    global LAST_FALLBACK_REASON
    key = PROVIDER_KEYS.get(model.split("/", 1)[0])
    if key and not os.environ.get(key):
        print(f"launch: {key} is not set; {agent_id} runs on {fallback}", file=sys.stderr)
        LAST_FALLBACK_REASON = f"{key} is not set"
        return fallback
    try:
        marker = json.loads((fleet_inbox_root() / agent_id / "model-fallback.json").read_text())
    except (OSError, ValueError):
        return model
    if marker.get("model") == model and marker.get("day") == datetime.now().date().isoformat():
        print(f"launch: {model} failed today ({str(marker.get('reason', ''))[:120]}); {agent_id} runs on {fallback}", file=sys.stderr)
        LAST_FALLBACK_REASON = f"{model} failed today: {str(marker.get('reason', ''))[:160]}"
        return fallback
    return model


def prepare_pi_launch(
    agent_id: str, extra: list[str] | None = None
) -> tuple[Path, list[str], Path, str | None] | None:
    """Build pi argv for agent_id. Returns (cwd, args, temp_role_prompt_path, model)."""
    extra = extra or []
    loaded = load_agent(agent_id)
    if not loaded:
        print(f"missing {ROOT / 'agents' / agent_id / 'agent.yaml'} (and no ship crewmate by that id)", file=sys.stderr)
        return None
    agent, aboard = loaded
    agent_type = str(agent.get("type") or "")
    uses_hermes = "hermes-memory" in [str(e) for e in agent.get("extensions") or []]
    harness = str(agent.get("harness") or "pi")
    role = str(agent.get("role") or agent_id)
    model = agent.get("model")

    if harness != "pi":
        print(f"harness {harness!r} is stored but only pi is wired in this slice", file=sys.stderr)
        return None

    role_file = ROOT / "roles" / f"{role}.md"
    if not role_file.is_file():
        print(f"missing role {role_file}", file=sys.stderr)
        return None

    if not (FLEET_HOME / "AGENTS.md").is_file():
        subprocess.run([str(ROOT / "bin" / "seed-fleet-home")], check=False)

    apply_fleet_home_env()
    configured = model
    model = model_with_fallback(model, agent.get("fallback_model"), agent_id)
    record_running_model(agent_id, configured, model)

    inbox = fleet_inbox_root()
    os.environ.setdefault("FLEET_INBOX", str(inbox))

    npm_reg = load_npm_registry()

    vault_raw = agent.get("vault")
    vault_agents = {"alice", "architect"}
    cwd: Path
    path_block: str
    if aboard:
        # Ship crewmate: lives in the ship's repo for the whole session.
        ship_path = Path(str(aboard["path"])).expanduser()
        cwd = ship_path
        os.environ["FLEET_SHIP"] = str(aboard["id"])
        # A voyage under sail has its own worktree: the crew works there, never in the captain's checkout.
        wt = voyage_worktree(str(aboard["id"]))
        if wt:
            cwd = Path(str(wt["path"]))
            os.environ["FLEET_SHIP_WORKTREE"] = str(wt["path"])
            os.environ["FLEET_SHIP_BRANCH"] = str(wt.get("branch", ""))
            if wt.get("gitDir"):
                os.environ["FLEET_VM_GITDIR"] = str(wt["gitDir"])
        else:
            for k in ("FLEET_SHIP_WORKTREE", "FLEET_SHIP_BRANCH", "FLEET_VM_GITDIR"):
                os.environ.pop(k, None)
        checks = aboard.get("checks") if isinstance(aboard.get("checks"), dict) else {}
        os.environ["FLEET_SHIP_CHECKS"] = ",".join(sorted(str(k) for k in checks))
        os.environ["FLEET_SHIP_MANEUVERS"] = ",".join(launchable_maneuvers(aboard, role, ship_path))
        if str(aboard.get("isolation") or "") == "vm":
            # R4: this crewmate's built-in tools run in a micro-VM with only the repo and its memory mounted.
            (fleet_inbox_root() / agent_id / "memory").mkdir(parents=True, exist_ok=True)
            os.environ.update(vm_env(aboard, agent_id, fleet_inbox_root(), agent))
        crew = ", ".join(f"`{aboard['id']}-{r}`" for r in aboard.get("crew") or [])
        path_block = (
            "## Resolved paths (this session)\n\n"
            f"- **Aboard ship:** `{aboard['id']}`; you are its `{role}` crewmate (`{agent_id}`)\n"
            + f"- **Ship repo:** `{ship_path}`; stay in this project. Work for other ships belongs to their crews. "
            "During a voyage your working folder is the voyage's worktree (see This voyage, at the end).\n"
            + f"- **Delivery mode:** `{aboard.get('mode') or 'unset'}`\n"
            + f"- **Crew aboard:** {crew}\n"
            f"- **FLEET_INBOX:** `{inbox}`\n"
            f"- Own bus (read): `{inbox / agent_id / 'events.jsonl'}`\n"
            f"- Firstmate bus (write): `{inbox / 'firstmate' / 'events.jsonl'}`\n"
            f"- Captain chat (read/write): `{inbox / agent_id / 'captain-chat.jsonl'}`\n"
            + dashboard_chat_block()
        )
    elif vault_raw or agent_id in vault_agents:
        default_vault = str(vault_raw) if vault_raw else "/Users/avega/Workspace/brain"
        vault_path = Path(os.environ.get("ALICE_VAULT", default_vault)).expanduser().resolve()
        os.environ["ALICE_VAULT"] = str(vault_path)
        cwd = vault_path
        path_block = (
            "## Resolved paths (this session)\n\n"
            f"- **ALICE_VAULT:** `{vault_path}`\n"
            f"- **FLEET_INBOX:** `{inbox}`\n"
            f"- Alice bus (read): `{inbox / 'alice' / 'events.jsonl'}`\n"
            f"- Architect bus (read): `{inbox / 'architect' / 'events.jsonl'}`\n"
            f"- Firstmate bus (write): `{inbox / 'firstmate' / 'events.jsonl'}`\n"
            f"- Vault human inbox: `{vault_path / 'fleet' / 'inbox'}/`\n"
            f"- Plans: `{vault_path / 'fleet' / 'plans'}/`\n"
            f"- Captain chat (read/write): `{inbox / agent_id / 'captain-chat.jsonl'}`\n"
            + (f"- Hermes project memory: `{vault_path / '.pi' / 'agent' / 'pi-hermes-memory'}/`\n" if uses_hermes else "")
            + dashboard_chat_block()
        )
        if uses_hermes:
            (vault_path / ".pi" / "agent" / "pi-hermes-memory").mkdir(parents=True, exist_ok=True)
        for skill in agent.get("skills") or []:
            skill_dir = cwd / ".pi" / "skills" / str(skill)
            if skill_dir.is_dir():
                pass  # added below in args
            else:
                print(f"warning: skill missing {skill_dir} (run bin/setup-alice-vault)", file=sys.stderr)
    elif str(agent.get("workspace") or "") == "repo":
        # Repo-upkeep agents (shipwright): work in this repo, not the vault or FM_HOME.
        cwd = ROOT
        vault_path = Path(os.environ.get("ALICE_VAULT", "/Users/avega/Workspace/brain")).expanduser()
        path_block = (
            "## Resolved paths (this session)\n\n"
            f"- **Repo (cwd):** `{ROOT}`\n"
            f"- **FLEET_INBOX:** `{inbox}`\n"
            f"- Agents: `{ROOT / 'agents'}/`, roles: `{ROOT / 'roles'}/`\n"
            f"- Ships: `{ROOT / 'fleet' / 'ships'}/`\n"
            f"- SSSF source: `{ROOT / '.claude' / 'skills' / 'sssf'}/`\n"
            f"- Firstmate project registry (read; write only with captain yes): `{FLEET_HOME / 'data' / 'projects.md'}`\n"
            f"- Vault initiatives (read only): `{vault_path / 'fleet' / 'initiatives'}/`\n"
            f"- Firstmate bus (write): `{inbox / 'firstmate' / 'events.jsonl'}`\n"
            f"- Captain chat (read/write): `{inbox / agent_id / 'captain-chat.jsonl'}`\n"
            + dashboard_chat_block()
        )
    elif str(agent.get("workspace") or "") == "ships":
        # Agents that work inside project repos (designer): start in this repo, cd per request.
        cwd = ROOT
        ship_lines = ""
        for y in sorted(ships_dir().glob("*.yaml")):
            ship = ship_config(y)
            if ship.get("path"):
                ship_lines += f"  - `{ship.get('id') or y.stem}`: `{ship['path']}`\n"
        path_block = (
            "## Resolved paths (this session)\n\n"
            f"- **Repo (start cwd):** `{ROOT}`; `cd` into the project named in each request\n"
            f"- **FLEET_INBOX:** `{inbox}`\n"
            "- Ships (id: path):\n" + (ship_lines or "  - none registered\n") +
            f"- Firstmate project registry (read only): `{FLEET_HOME / 'data' / 'projects.md'}`\n"
            f"- Own bus (read): `{inbox / agent_id / 'events.jsonl'}`\n"
            f"- Firstmate bus (write): `{inbox / 'firstmate' / 'events.jsonl'}`\n"
            f"- Captain chat (read/write): `{inbox / agent_id / 'captain-chat.jsonl'}`\n"
            + dashboard_chat_block()
        )
    else:
        home = FLEET_HOME
        cwd = home
        os.environ["FM_HOME"] = str(home)
        path_block = (
            "## Resolved paths (this session)\n\n"
            f"- **FM_HOME:** `{home}`\n"
            f"- **FLEET_INBOX:** `{inbox}`\n"
            f"- Alice bus (write): `{inbox / 'alice' / 'events.jsonl'}`\n"
            f"- Architect bus (write): `{inbox / 'architect' / 'events.jsonl'}`\n"
            f"- Captain chat (read/write): `{inbox / agent_id / 'captain-chat.jsonl'}`\n"
            + dashboard_chat_block()
        )

    cwd_override = agent.get("cwd")
    if cwd_override:
        cwd = (ROOT / str(cwd_override)).resolve()

    extra_prompt_files: list[Path] = []
    for rel in agent.get("extra_prompts") or []:
        extra_prompt_files.append((ROOT / str(rel)).resolve())

    if agent_type == "assistant":
        if aboard:
            isolated_vm = str(aboard.get("isolation") or "") == "vm"
            path_block += crew_memory_block(agent_id, str(aboard["id"]), inbox, isolated_vm, voyage_worktree(str(aboard["id"])))
        else:
            path_block += memory_block(agent_id, inbox)
    prompt_file = build_role_prompt(role_file, path_block, extra_prompt_files)
    args = ["pi", "--approve", "--append-system-prompt", str(prompt_file)]

    if model:
        args.extend(["--model", str(model)])

    ext_refs: list[str] = []
    for name in agent.get("extensions") or []:
        ok, ref = extension_allowed(str(name), agent_type, npm_reg)
        if not ok:
            print(f"extension {name!r} not allowed for type {agent_type}", file=sys.stderr)
            return None
        ext_refs.append(ref if ref.startswith("npm:") else ref)

    # Every assistant can ask the captain structured questions (ask-captain.ts),
    # show work on the dashboard canvas (canvas.ts), sends only its newest
    # screenshots to the model (image-window.ts), compacts between tasks once
    # context passes 65% (context-guard.ts), and watches prompt caching and
    # repeated reads (cache-watch.ts).
    if agent_type == "assistant":
        # Crewmates also work as a crew: tasks, crew messages, maneuvers (crew.ts).
        isolated = bool(aboard) and str(aboard.get("isolation") or "") == "vm"
        for name in ("ask-captain", "canvas", "image-window", "context-guard", "cache-watch") + (("crew",) if aboard else ()) + (("gondolin",) if isolated else ()):
            ref = str(ROOT / "extensions" / f"{name}.ts")
            if ref not in ext_refs:
                ext_refs.append(ref)
    os.environ["FLEET_AGENT_ID"] = agent_id
    # Per-agent tuning (e.g. Firstmate's FM_* watcher settings); the caller's env wins.
    for key, val in (agent.get("env") or {}).items():
        if re.fullmatch(r"[A-Z][A-Z0-9_]*", str(key)) and val is not None and key not in os.environ:
            os.environ[key] = str(val)

    for ref in ext_refs:
        args.extend(["-e", ref])

    # `tools:` in agent.yaml adjusts the declared tools, e.g. [+codemode, +tool_search].
    tool_changes = [str(t) for t in agent.get("tools") or [] if re.fullmatch(r"[+-]?[a-z_]+", str(t))]
    if tool_changes:
        args.extend(["--tools", ",".join(tool_changes)])

    if vault_raw or agent_id in vault_agents:
        for skill in agent.get("skills") or []:
            skill_dir = cwd / ".pi" / "skills" / str(skill)
            if skill_dir.is_dir():
                args.extend(["--skill", str(skill_dir)])

    # `discover_skills: false`: only the skills named here, none found on disk (a
    # skill list in the system prompt costs every turn; Alice's global skills were 28k chars).
    if str(agent.get("discover_skills")).lower() == "false":
        args.append("--no-skills")

    # Repo-relative skill folders (each holds a SKILL.md), for any agent type.
    for rel in agent.get("skill_paths") or []:
        skill_dir = (ROOT / str(rel)).resolve()
        if (skill_dir / "SKILL.md").is_file():
            args.extend(["--skill", str(skill_dir)])
        else:
            print(f"warning: skill_paths entry missing SKILL.md: {skill_dir}", file=sys.stderr)

    args.extend(extra)
    model_str = str(model) if model else None
    # R4c: an assistant's process holds only its own providers' keys (a crewmate's
    # VM holds none at all: extensions/gondolin passes a fixed environment).
    if agent_type == "assistant":
        restrict_keys(agent)
    return cwd, args, prompt_file, model_str


def persistent_session_args(agent_id: str) -> list[str]:
    """Shared Pi session for agents with `dashboard_session: persistent`.

    Dashboard turns and the interactive TUI (`just <id>`, or Start TUI on the
    dashboard) resume the same session, so the conversation carries across both.
    The dashboard's New session writes a fresh id to sessions/current; without
    that file the id is dashboard-<id>.
    """
    loaded = load_agent(agent_id)
    agent = loaded[0] if loaded else {}
    if str(agent.get("dashboard_session") or "") != "persistent":
        return []
    session_dir = fleet_inbox_root() / agent_id / "sessions"
    session_dir.mkdir(parents=True, exist_ok=True)
    session_id = f"dashboard-{agent_id}"
    try:
        current = (session_dir / "current").read_text().strip()
        if re.fullmatch(r"dashboard-[a-z0-9_-]{1,80}", current):
            session_id = current
    except OSError:
        pass
    return ["--session-dir", str(session_dir), "--session-id", session_id]


def tui_pid_alive(agent_id: str) -> int | None:
    """PID of a live interactive session for agent_id (fleet/inbox/<id>/session.json), else None."""
    try:
        pid = int(json.loads((fleet_inbox_root() / agent_id / "session.json").read_text())["pid"])
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError, KeyError, TypeError):
        return None


def headless_main() -> int:
    if len(sys.argv) < 3:
        print("usage: bin/launch headless <agent-id>  (prompt on stdin)", file=sys.stderr)
        return 2
    agent_id = sys.argv[2]
    user_prompt = sys.stdin.read().strip()
    if not user_prompt:
        print("empty prompt on stdin", file=sys.stderr)
        return 2
    prepared = prepare_pi_launch(agent_id, [])
    if prepared is None:
        return 1
    cwd, base_args, prompt_file, _model = prepared
    session_args = persistent_session_args(agent_id)
    if session_args and tui_pid_alive(agent_id):
        # Both would write the same session file. The TUI is the live one.
        print(
            f"{agent_id} is open in its TUI right now, so this message was not run. "
            f"Answer it there (herdr pane fleet-{agent_id}, or the terminal running `just {agent_id}`), "
            "or close the TUI to chat here again.",
            file=sys.stderr,
        )
        try:
            prompt_file.unlink(missing_ok=True)
        except OSError:
            pass
        return 3
    if not session_args:
        session_args = ["--no-session"]
    args = base_args + ["-p", *session_args, user_prompt]
    print(f"cd {cwd} && {' '.join(base_args)} -p {' '.join(session_args)} …", file=sys.stderr)
    env = os.environ.copy()
    # pi-cursor-sdk's own cursor_ask_question tells the model "UI unavailable, pick a
    # default" in print mode. Turn it off so ask_captain is the question tool here.
    env["PI_CURSOR_ASK_QUESTION"] = "false"
    proc = subprocess.Popen(
        args,
        cwd=str(cwd),
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )

    def stop_child(signum, _frame):
        # The dashboard stops a turn by signalling this launcher; take pi down
        # with it so a timed-out agent does not keep working unseen.
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
        sys.exit(128 + signum)

    signal.signal(signal.SIGTERM, stop_child)
    signal.signal(signal.SIGINT, stop_child)
    try:
        stdout, stderr = proc.communicate()
        if proc.returncode != 0:
            err = (stderr or stdout or "pi headless failed").strip()
            print(err, file=sys.stderr)
            return proc.returncode if proc.returncode else 1
        out = (stdout or "").strip()
        if out:
            print(out)
        return 0
    finally:
        try:
            prompt_file.unlink(missing_ok=True)
        except OSError:
            pass


def rpc_main() -> int:
    """`bin/launch rpc <id>`: exec pi in RPC mode for the dashboard's agent host.

    stdin/stdout carry Pi's JSONL RPC protocol, so nothing else may print to
    stdout. The session is the agent's persistent one when it has
    `dashboard_session: persistent`.
    """
    global RUNTIME
    if len(sys.argv) < 3:
        print("usage: bin/launch rpc <agent-id>", file=sys.stderr)
        return 2
    agent_id = sys.argv[2]
    RUNTIME = "rpc"
    if tui_pid_alive(agent_id):
        print(
            f"{agent_id} is open in its TUI right now. Answer it there (herdr pane fleet-{agent_id}, "
            f"or the terminal running `just {agent_id}`), or close the TUI to chat from the dashboard.",
            file=sys.stderr,
        )
        return 3
    prepared = prepare_pi_launch(agent_id, [])
    if prepared is None:
        return 1
    cwd, base_args, prompt_file, _model = prepared
    # exec leaves nobody to delete a temp prompt, so RPC launches keep one
    # stable copy per agent, replaced on each launch.
    stable = fleet_inbox_root() / agent_id / "role-prompt.md"
    stable.parent.mkdir(parents=True, exist_ok=True)
    os.replace(prompt_file, stable)
    base_args = [str(stable) if a == str(prompt_file) else a for a in base_args]
    session_args = persistent_session_args(agent_id) or ["--no-session"]
    args = base_args + ["--mode", "rpc", *session_args]
    print(f"cd {cwd} && {' '.join(base_args)} --mode rpc {' '.join(session_args)}", file=sys.stderr)
    os.chdir(cwd)
    os.execvpe(args[0], args, os.environ.copy())


def main() -> int:
    if len(sys.argv) >= 2 and sys.argv[1] == "headless":
        return headless_main()
    if len(sys.argv) >= 2 and sys.argv[1] == "rpc":
        return rpc_main()
    if len(sys.argv) < 2:
        print("usage: bin/launch <agent-id> [-- extra pi args...]", file=sys.stderr)
        print("       bin/launch headless <agent-id>  # prompt on stdin", file=sys.stderr)
        print("       bin/launch rpc <agent-id>       # Pi RPC on stdin/stdout (dashboard agent host)", file=sys.stderr)
        return 2
    agent_id = sys.argv[1]
    extra: list[str] = []
    if "--" in sys.argv:
        extra = sys.argv[sys.argv.index("--") + 1 :]

    prepared = prepare_pi_launch(agent_id, extra)
    if prepared is None:
        return 1
    cwd, args, prompt_file, model = prepared
    session_flags = ("--session", "--session-id", "--session-dir", "--no-session", "--continue", "-c", "--resume", "-r", "--fork")
    if not any(a in session_flags for a in extra):
        args += persistent_session_args(agent_id)
    print(f"cd {cwd} && {' '.join(args)}", file=sys.stderr)

    agent_inbox = fleet_inbox_root() / agent_id
    agent_inbox.mkdir(parents=True, exist_ok=True)
    session_path = agent_inbox / "session.json"

    def remove_session() -> None:
        try:
            session_path.unlink(missing_ok=True)
        except OSError:
            pass

    def write_session(pid: int) -> None:
        payload: dict = {
            "pid": pid,
            "agent": agent_id,
            "model": model,
            "started": datetime.now(timezone.utc).isoformat(),
        }
        if os.environ.get("FLEET_HERDR_SESSION"):
            payload["backend"] = "herdr"
            payload["herdr_session"] = os.environ["FLEET_HERDR_SESSION"]
            for key, field in (
                ("FLEET_HERDR_WORKSPACE_ID", "herdr_workspace_id"),
                ("FLEET_HERDR_PANE_ID", "herdr_pane_id"),
            ):
                if os.environ.get(key):
                    payload[field] = os.environ[key]
        session_path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")

    os.chdir(cwd)
    child = subprocess.Popen(args, cwd=str(cwd), env=os.environ.copy())

    def forward_signal(signum: int, _frame) -> None:
        if child.poll() is None:
            child.send_signal(signum)

    signal.signal(signal.SIGINT, forward_signal)
    signal.signal(signal.SIGTERM, forward_signal)

    write_session(child.pid)
    try:
        return child.wait()
    finally:
        remove_session()
        try:
            prompt_file.unlink(missing_ok=True)
        except OSError:
            pass


if __name__ == "__main__":
    sys.exit(main())
