#!/usr/bin/env python3
"""Merge fleet DeepSeek + Hugging Face provider snippets into Pi models-store.json."""
from __future__ import annotations

import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SNIPPETS = [
    ROOT / "fleet/config/pi-deepseek-provider.json",
    ROOT / "fleet/config/pi-huggingface-provider.json",
]


def pi_models_store() -> Path:
    home = Path.home()
    return home / ".pi" / "agent" / "models-store.json"


def load_providers(path: Path) -> dict:
    data = json.loads(path.read_text())
    providers = data.get("providers")
    if not isinstance(providers, dict):
        print(f"{path}: missing providers object", file=sys.stderr)
        sys.exit(1)
    return providers


def main() -> int:
    target = pi_models_store()
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.is_file():
        try:
            store = json.loads(target.read_text())
        except json.JSONDecodeError as e:
            print(f"invalid JSON in {target}: {e}", file=sys.stderr)
            return 1
    else:
        store = {}
    if "providers" not in store or not isinstance(store["providers"], dict):
        store["providers"] = {}

    merged = 0
    for snippet in SNIPPETS:
        if not snippet.is_file():
            print(f"skip missing {snippet}", file=sys.stderr)
            continue
        for name, cfg in load_providers(snippet).items():
            store["providers"][name] = cfg
            merged += 1
            print(f"merged provider {name!r} from {snippet.name}")

    target.write_text(json.dumps(store, indent=2) + "\n", encoding="utf-8")
    print(f"wrote {target} ({merged} providers merged)")
    print("OpenRouter: use Pi built-in openrouter provider with OPENROUTER_API_KEY in env.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
