const [cmd = "", ...rest] = process.argv.slice(2);

function fail(message: string, suggestion: string, code = 2): never {
  console.log(encode({ error: message, suggestion }));
  process.exit(code);
}

function flag(name: string): string | undefined {
  const i = rest.indexOf(name);
  return i >= 0 ? rest[i + 1] : undefined;
}

async function home(brief: boolean): Promise<void> {
  const s = (await fleetStatus(false)) as { message: string; needsCaptain?: unknown[] };
  const ready = vaultTasksReport("ready") as { tasks?: { id: string; title: string; priority: string }[]; message: string };
  const out: Record<string, unknown> = {
    ...(brief ? {} : { bin: "~/Workspace/agents/bin/fleet-axi", description: "The fleet from any shell (read-only)" }),
    fleet: s.message,
    waiting_on_captain: s.needsCaptain?.length ? s.needsCaptain.slice(0, 8) : "0 items",
    vault: ready.message,
    ready: ready.tasks?.length ? ready.tasks.slice(0, brief ? 5 : 8).map((t) => ({ id: t.id, priority: t.priority, title: t.title })) : "0 ready tasks",
    help: brief ? ["bin/fleet-axi --help"] : ["bin/fleet-axi status --detail", "bin/fleet-axi ship <id>", "bin/fleet-axi vault in-progress", "bin/fleet-axi next", "bin/fleet-axi jev", "bin/fleet-axi query spend --by agent", "bin/fleet-axi search <words>"],
  };
  console.log(encode(out));
}

type Settings = { hooks?: { SessionStart?: { hooks?: { type: string; command: string }[] }[] } };

/** True when the Claude Code settings file at `path` has a fleet-axi SessionStart hook; false when it is missing or unreadable. */
function hasFleetAxiHook(path: string): boolean {
  try {
    const cfg = JSON.parse(readFileSync(path, "utf8")) as Settings;
    return !!cfg.hooks?.SessionStart?.some((s) => s.hooks?.some((h) => h.command.includes("bin/fleet-axi")));
  } catch {
    return false;
  }
}

/** Arguments that are not flags or flag values. */
function positional(): string[] {
  const out: string[] = [];
  for (let i = 0; i < rest.length; i++) {
    if (!rest[i]!.startsWith("--")) out.push(rest[i]!);
    else if (!SWITCHES.includes(rest[i]!)) i++;
  }
  return out;
}

async function main(): Promise<void> {
  if (cmd === "--version" || cmd === "-v" || cmd === "-V") return void console.log("1.0.0");
  if (cmd === "--help" || cmd === "-h" || rest.includes("--help")) {
    const h = HELP[cmd.startsWith("-") ? "" : cmd];
    if (h === undefined) fail(`unknown command ${cmd}`, `commands: ${COMMANDS.join(", ")} (bin/fleet-axi --help)`);
    return void console.log(h);
  }
  const key = cmd.startsWith("--") ? "" : cmd;
  if (key && !(COMMANDS as readonly string[]).includes(key)) fail(`unknown command ${cmd}`, `commands: ${COMMANDS.join(", ")} (bin/fleet-axi --help)`);
  const args = key ? rest : [cmd, ...rest].filter(Boolean);
  for (let i = 0; i < args.length; i++) {
    const a = args[i]!;
    if (!a.startsWith("--")) continue;
    if (!(FLAGS[key] ?? []).includes(a)) fail(`unknown flag ${a}${key ? ` for ${key}` : ""}`, `valid flags: ${[...(FLAGS[key] ?? []), "--help"].join(", ")}`);
    if (!SWITCHES.includes(a)) i++;
  }

  if (!key) {
    if (args.includes("--brief") && args.includes("--hub-part")) return void console.log(await hubPart());
    // A hook runs this at every session start: whatever goes wrong, say so and exit 0.
    if (args.includes("--brief") && args.includes("--engineer")) return void console.log(await engineerBrief().catch((e) => `- unavailable: ${e instanceof Error ? e.message : e}\n`));
    return home(args.includes("--brief"));
  }
  const full = rest.includes("--full");
  if (key === "status") return void console.log(toolText(await fleetStatus(rest.includes("--detail")), VIEWS.fleet_status, { full }));
  if (key === "ship") {
    const id = rest.find((a) => !a.startsWith("--") && a !== flag("--log"));
    if (!id) fail("ship needs a ship id", "bin/fleet-axi ship <id> (bin/fleet-axi status lists the ships)");
    const n = Math.min(200, Math.max(1, Number(flag("--log") ?? 15) || 15));
    console.log(toolText(await shipTasks(id), VIEWS.ship_tasks, { full }));
    console.log(toolText(shipLog(id, n), VIEWS.ship_log, { full }));
    return;
  }
  if (key === "vault") {
    const id = flag("--id") ?? "";
    const filter = rest.find((a) => !a.startsWith("--") && a !== id) ?? "ready";
    if (!(VAULT_FILTERS as string[]).includes(filter)) fail(`unknown filter ${filter}`, `filters: ${VAULT_FILTERS.join(", ")}`);
    return void console.log(toolText(vaultTasksReport(filter as VaultFilter, id), VIEWS.vault_tasks, { full }));
  }
  if (key === "next" && flag("--ship") !== undefined) {
    const ship = flag("--ship") ?? "";
    if (!ship || ship.startsWith("--")) fail("--ship needs a ship id or all", "bin/fleet-axi next --ship pochteca (bin/fleet-axi status lists the ships)");
    const r = await shipNext(ship, full);
    if (!r.ok) fail(r.message, "bin/fleet-axi status lists the ships");
    return void console.log(toolText(r, VIEWS.ship_next!, { full }));
  }
  if (key === "next") {
    const id = linkName(flag("--id") ?? "");
    const r = vaultNextSteps();
    if (!id) return void console.log(encode({ result: r.message, tasks: r.tasks, ...(r.unreadable ? { unreadable: r.unreadable } : {}) }));
    const t = r.tasks.find((x) => x.id === id);
    if (!t) fail(`no active vault task ${id}`, `active: ${r.tasks.map((x) => x.id).join(", ") || "none"} (bin/fleet-axi vault all lists every task)`);
    return void console.log(encode(t));
  }
  if (key === "jev" || key === "gate" || key === "query") {
    const name = key === "query" ? positional()[0] : key;
    if (!name) fail("query needs a name", `bin/fleet-axi query <${FLEET_QUERIES.join("|")}>`);
    const days = flag("--days") === undefined ? undefined : Math.max(1, Number(flag("--days")) || 7);
    const r = fleetQuery(name, { days: days ?? (key === "gate" ? 1 : name === "searches" || name === "surveys" ? undefined : 7), by: flag("--by"), since: flag("--since"), until: flag("--until"), limit: Number(flag("--limit")) || undefined, full: rest.includes("--full") });
    if (!r.ok) fail(r.message, `bin/fleet-axi query --help (queries: ${FLEET_QUERIES.join(", ")})`);
    return void console.log(toolText(r, VIEWS.fleet_query, { full: rest.includes("--full") }));
  }
  if (key === "bash-use") {
    const days = flag("--days") === undefined ? 7 : Math.max(1, Number(flag("--days")) || 7);
    const rows = await bashUse({ days, agent: flag("--agent") });
    if (flag("--agent") && !rows.length) fail(`no sessions for ${flag("--agent")}`, "pass an agent id (kinwork-lead) or a role (lead); the folders under the fleet inbox are the ids");
    return void console.log(encode({ days, agents: rows.length, bash_calls: rows.reduce((n, r) => n + r.bashCalls, 0), by_agent: bashUseRows(rows) }));
  }
  if (key === "note") {
    const path = positional()[0];
    if (!path) fail("note needs a path", "bin/fleet-axi note <path> (bin/fleet-axi search finds notes)");
    const r = vaultNote(path, { section: flag("--section"), full: rest.includes("--full") });
    if (!r.ok) fail(r.message, "bin/fleet-axi search <words> finds the note; bin/fleet-axi note <path> lists its headings");
    return void console.log(toolText(r, VIEWS.vault_note));
  }
  if (key === "search") {
    const r = searchVault({ query: positional().join(" ") || undefined, type: flag("--type"), status: flag("--status"), ship: flag("--ship"), path: flag("--path"), limit: Number(flag("--limit")) || undefined });
    if (!r.ok) fail(r.message, "bin/fleet-axi search --help");
    return void console.log(toolText(r, VIEWS.vault_search));
  }
  if (key === "facts") {
    const r = factGet({ subject: positional()[0], key: flag("--key"), history: rest.includes("--history") });
    if (!r.ok) fail(r.message, "bin/fleet-axi facts --help");
    return void console.log(toolText(r, VIEWS.fact_get));
  }
  if (key === "intents") {
    if (positional()[0] === "label") {
      const [, id, owner] = positional();
      if (!id || !owner || !Number.isInteger(Number(id))) fail("label needs an id and an owner", `bin/fleet-axi intents label <id> <${intentOptions().map((o) => o.name).join("|")}>`);
      const r = labelIntent(Number(id), owner);
      if (!r.ok) fail(r.message, "bin/fleet-axi intents lists the verdict ids");
      return void console.log(encode({ ok: r.message }));
    }
    const days = flag("--days") === undefined ? 7 : Math.max(1, Number(flag("--days")) || 7);
    const r = intentReport({ days, unlabelledOnly: rest.includes("--unlabelled"), limit: Math.min(200, Number(flag("--limit")) || 30) });
    return void console.log(encode({ verdicts: r.total, per_choice: r.perChoice, by_confidence: r.buckets, recent: r.rows.map((x) => ({ id: x.id, ts: x.ts, excerpt: x.excerpt, choice: x.choice, confidence: Math.round(x.confidence * 100) / 100, label: x.label ?? "" })) }));
  }
  if (key === "extract") {
    if (positional()[0] === "run") {
      if (extractMode() === "off") fail("memory extraction is off", "unset FLEET_MEMORY_EXTRACT");
      const list = candidates({ agent: flag("--agent"), since: flag("--since") });
      if (rest.includes("--dry-run")) return void console.log(encode({ candidates: list.length, jev_calls_for_classify: Math.ceil(list.length / 5), note: "preferences and facts add a few match calls each", messages: list.map((c) => ({ agent: c.agent, ts: c.line_ts, quote: c.text.slice(0, 120) })) }));
      const r = await extract(list);
      return void console.log(encode({ candidates: r.candidates, proposed: r.proposed, matched_to_memory: r.matched, failed: r.failed, jev_calls: r.calls, per_label: r.byLabel }));
    }
    if (positional()[0] === "label") {
      const [, id, label] = positional();
      if (!id || !label || !Number.isInteger(Number(id))) fail("label needs an id and a label", `bin/fleet-axi extract label <id> <${LABELS.join("|")}>`);
      const r = labelProposal(Number(id), label, flag("--target"));
      if (!r.ok) fail(r.message, "bin/fleet-axi extract lists the proposal ids");
      return void console.log(encode({ ok: r.message }));
    }
    const days = flag("--days") === undefined ? 7 : Math.max(1, Number(flag("--days")) || 7);
    const r = proposalReport({ days, unlabelledOnly: rest.includes("--unlabelled"), limit: Math.min(200, Number(flag("--limit")) || 30) });
    return void console.log(encode({ proposals: r.total, per_label: r.perLabel, by_confidence: r.buckets, accepted: r.acceptance.approved, dismissed: r.acceptance.dismissed, acceptance_rate: r.acceptance.rate ?? "", acceptance_by_label: r.acceptance.perLabel, acceptance_by_confidence: r.acceptance.buckets, recent: r.rows.map((x) => ({ id: x.id, agent: x.agent, quote: x.quote.slice(0, 160), label: x.label, confidence: Math.round(x.confidence * 100) / 100, target: x.target ?? "", replaces: x.replaces ?? "", captain_label: x.captain_label ?? "" })) }));
  }
  if (key === "proactive") {
    const [sub, what, days] = positional();
    if (sub === "snooze" || sub === "done") {
      if (!what || (sub === "snooze" && !(Number(days) > 0))) fail(`${sub} needs ${sub === "snooze" ? "a fingerprint or key and a number of days" : "a key"}`, `bin/fleet-axi proactive ${sub} <fingerprint|key>${sub === "snooze" ? " <days>" : ""}`);
      const n = giveFeedback(what, sub === "done" ? "done" : { snooze: Number(days) });
      if (!n) fail(`no current finding for ${what}`, "bin/fleet-axi proactive lists the findings with their keys and fingerprints");
      return void console.log(encode({ ok: `${n} finding${n > 1 ? "s" : ""} ${sub === "done" ? "marked done" : `snoozed ${days} days`}` }));
    }
    if (sub) fail(`unknown proactive command ${sub}`, "bin/fleet-axi proactive [snooze <fingerprint|key> <days> | done <key>]");
    const verdicts = judge(computeFindings(gatherInput()), new Date());
    return void console.log(encode({ mode: proactiveMode(), repeat_days: repeatDays(), stale_task_days: staleTaskDays(), proposals_30d: proposalReport(30), findings: verdicts.length, would_raise: verdicts.filter((v) => v.raise).length, list: verdicts.map((v) => ({ kind: v.finding.kind, key: v.finding.key, summary: v.finding.summary, raise: v.raise, why: v.why, fingerprint: v.finding.fingerprint })) }));
  }
  if (key === "review") {
    const path = positional()[0];
    const writer = flag("--writer");
    if (!path) fail("review needs a vault path", "bin/fleet-axi review <vault path> --writer <model> (bin/survey runs it on the hub)");
    if (!writer || writer.startsWith("--")) fail("review needs --writer", "pass the model that wrote the note, e.g. --writer anthropic/claude-opus-5.5, so no reviewer shares it");
    const r = await requestSurvey({ mode: flag("--mode") ?? "review", path, writer, ship: flag("--ship"), depth: flag("--depth"), lenses: flag("--lenses") });
    if (!r.ok) fail(r.message, "bin/fleet-axi review --help");
    if (!r.id) return void console.log(encode({ result: r.message }));
    console.error(r.message);
    // The node does the work; the journal is shared, so the parent workflow says when it ends (at most FLEET_SURVEY_WAIT_MIN, default 60).
    const until = Date.now() + (Number(process.env.FLEET_SURVEY_WAIT_MIN) || 60) * 60_000;
    for (;;) {
      const w = getWorkflow<{ review?: string; cost?: number; counts?: Record<string, number>; error?: string }>(r.id);
      if (w && w.status !== "running" && w.status !== "waiting") {
        if (w.data.review) return void console.log(encode({ result: w.status === "done" ? "review written" : `review written, but ${w.data.error ?? "it failed"}`, review: w.data.review, cost_usd: w.data.cost, findings: w.data.counts, next: "resolve each finding under '## Resolution' (F<n>: fix|contest|escalate|decline — why)" }));
        fail(`the review ${w.status}: ${w.data.error ?? "no reason recorded"}`, `bin/fleet-axi review --help; workflow ${r.id}`, 1);
      }
      if (Date.now() > until) fail(`the review ${r.id} is still running after the wait limit`, "it keeps running on the node; look for fleet/reviews/<slug>/ in the vault later", 1);
      await Bun.sleep(3000);
    }
  }
  if (key === "setup") {
    if (rest[0] !== "hooks") fail("setup takes hooks", "bin/fleet-axi setup hooks");
    const path = join(ROOT, ".claude", "settings.local.json");
    // The committed settings.json carries the engineer's hook; a second one would print the brief twice.
    const shared = join(ROOT, ".claude", "settings.json");
    if (hasFleetAxiHook(shared)) return void console.log(encode({ ok: "already set up (no change)", file: shared }));
    const command = `${join(ROOT, "bin", "fleet-axi")} --brief`;
    let cfg: Settings = {};
    if (existsSync(path)) {
      try {
        cfg = JSON.parse(readFileSync(path, "utf8"));
      } catch {
        fail(`${path} is not valid JSON`, "fix the file, then run setup hooks again", 1);
      }
    }
    const starts = (cfg.hooks ??= {}).SessionStart ??= [];
    if (starts.some((s) => s.hooks?.some((h) => h.command.includes("bin/fleet-axi")))) return void console.log(encode({ ok: "already set up (no change)", file: path }));
    starts.push({ hooks: [{ type: "command", command }] });
    writeFileSync(path, `${JSON.stringify(cfg, null, 2)}\n`, "utf8");
    return void console.log(encode({ ok: "SessionStart hook added", file: path, command, next: "start a new Claude Code session in this repo to see the fleet summary first" }));
  }
}

await main();
process.exit(0);
