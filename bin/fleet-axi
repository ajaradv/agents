import { searchVault } from "../dashboard/lib/vault-index.ts";
import { vaultNote } from "../dashboard/lib/vault-note.ts";

const COMMANDS = ["status", "ship", "vault", "next", "jev", "gate", "query", "bash-use", "note", "search", "facts", "intents", "extract", "proactive", "review", "setup"] as const;
const FLAGS: Record<string, string[]> = {
  status: ["--detail", "--full"],
  ship: ["--log", "--full"],
  vault: ["--id", "--full"],
  next: ["--id", "--ship", "--full"],
  jev: ["--days"],
  gate: ["--days", "--limit", "--full"],
  query: ["--days", "--since", "--until", "--by", "--limit", "--full"],
  "bash-use": ["--days", "--agent"],
  note: ["--section", "--full"],
  search: ["--type", "--status", "--ship", "--path", "--limit"],
  facts: ["--key", "--history"],
  intents: ["--days", "--unlabelled", "--limit"],
  extract: ["--days", "--unlabelled", "--limit", "--agent", "--since", "--dry-run", "--target"],
  proactive: [],
  review: ["--mode", "--depth", "--lenses", "--writer", "--ship"],
  setup: [],
  "": ["--brief", "--engineer", "--hub-part"],
};
/** Flags that take no value. */
const SWITCHES = ["--detail", "--brief", "--engineer", "--hub-part", "--full", "--history", "--unlabelled", "--dry-run"];

