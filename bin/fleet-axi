#!/usr/bin/env bun
// fleet-axi - the fleet from any shell: what is running, what waits on the captain,
// voyages, ship logs, vault tasks and notes, Jev spend, and tool gate decisions. Read-only
// (search refreshes the vault mirror, a derived cache in the journal database; intents label
// stores the captain's label; proactive snooze/done store the captain's feedback).
// Harness-agnostic (docs/tool-standards.md): Claude Code, pi, or a script can run it.
// The same libraries and output views as the officers' fleet tools.
//
//   bin/fleet-axi                      summary: ships, what waits on the captain, ready vault tasks
//   bin/fleet-axi status [--detail] [--full]    the fleet: ships, voyages, crews, spend today
//   bin/fleet-axi ship <id> [--log N] [--full]  a ship's voyage tasks and its latest log lines
//   bin/fleet-axi vault [filter] [--id <task>] [--full]   vault tasks (ready, open, in-progress, blocked, done, all)
//   bin/fleet-axi next [--id <task>]   what is left on the active vault tasks (their Done-when checklists)
//   bin/fleet-axi next --ship <ship|all> [--full]   a ship's roadmap: Now, Next up, open questions (what the ship_next tool answers)
//   bin/fleet-axi jev [--days N]       Jev calls and spend per use, and the compaction advisor
//   bin/fleet-axi gate [--days N]      tool gate decisions
//   bin/fleet-axi query <name> [--days N] [--since D] [--until D] [--by X] [--limit N] [--full]   spend, tool_failures, jev, gate, voyages, surveys, searches (what the fleet_query tool answers)
//   bin/fleet-axi bash-use [--days N] [--agent A]   bash tool calls per agent from the session transcripts, by first word (the check before an officer loses bash)
//   bin/fleet-axi note <path> [--section X] [--full]  one vault note: frontmatter, headings, one section
//   bin/fleet-axi search [words] [--type T] [--status S] [--ship S] [--path P]   vault notes by words and frontmatter
//   bin/fleet-axi facts [subject] [--key K] [--history]   Alice's recorded facts (what the fact_get tool answers)
//   bin/fleet-axi intents [--days N] [--unlabelled]   who Jev would route the captain's messages to (observe mode), with accuracy where labelled
//   bin/fleet-axi intents label <id> <owner>   the captain's label: who should have owned that message
//   bin/fleet-axi proactive            the proactive sweep's findings now, and which would be raised to Alice and why
//   bin/fleet-axi proactive snooze <fingerprint|key> <days>   hold a finding; proactive done <key> ends it until the thing changes
//   bin/fleet-axi review <vault path> --writer <model> [--mode review|brainstorm] [--depth skip|light|full] [--lenses +comprehension] [--ship S]   fresh reviewers on other models; waits and prints the review file (bin/survey runs it on the hub)
//   bin/fleet-axi --brief --engineer   the engineer's session brief (repo, PRs, hub, plans, roadmap, handoff); always exits 0
//   bin/fleet-axi --brief --hub-part   the Hub and Fleet sections of that brief, computed here (the laptop asks the hub for them)
//   bin/fleet-axi setup hooks          opt in: show the summary at the start of Claude Code sessions in this repo
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { encode } from "@toon-format/toon";
import { fleetStatus, shipLog, shipTasks } from "../dashboard/lib/fleet-api.ts";
import { bashUse, bashUseRows } from "../dashboard/lib/bash-use.ts";
import { FLEET_QUERIES, fleetQuery, SPEND_BY } from "../dashboard/lib/fleet-query.ts";
import { factGet } from "../dashboard/lib/facts.ts";
import { candidates, extract, extractMode, LABELS, labelProposal, proposalReport } from "../dashboard/lib/memory-extract.ts";
import { intentOptions, intentReport, labelIntent } from "../dashboard/lib/intent-route.ts";
import { computeFindings, gatherInput, giveFeedback, judge, proactiveMode, proposalReport, repeatDays, staleTaskDays } from "../dashboard/lib/proactive.ts";
import { ROOT } from "../dashboard/lib/paths.ts";
import { toolText, VIEWS } from "../dashboard/lib/tool-out.ts";
import { linkName, VAULT_FILTERS, vaultNextSteps, vaultTasksReport, type VaultFilter } from "../dashboard/lib/vault-tasks.ts";
import { engineerBrief, hubPart } from "../dashboard/lib/engineer-brief.ts";
import { getWorkflow } from "../dashboard/lib/journal.ts";
import { requestSurvey } from "../dashboard/lib/node-client.ts";
