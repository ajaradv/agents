#!/usr/bin/env bun
// fleet-axi - the fleet from any shell: what is running, what waits on the captain,
// voyages, ship logs, vault tasks and notes, Jev spend, and tool gate decisions. Read-only
// (search refreshes the vault mirror, a derived cache in the journal database).
// Harness-agnostic (docs/tool-standards.md): Claude Code, pi, or a script can run it.
// The same libraries and output views as the officers' fleet tools.
//
//   bin/fleet-axi                      summary: ships, what waits on the captain, ready vault tasks
//   bin/fleet-axi status [--detail]    the fleet: ships, voyages, crews, spend today
//   bin/fleet-axi ship <id> [--log N]  a ship's voyage tasks and its latest log lines
//   bin/fleet-axi vault [filter] [--id <task>]   vault tasks (ready, open, in-progress, blocked, done, all)
//   bin/fleet-axi next [--id <task>]   what is left on the active vault tasks (their Done-when checklists)
//   bin/fleet-axi jev [--days N]       Jev calls and spend per use, and the compaction advisor
//   bin/fleet-axi gate [--days N]      tool gate decisions
//   bin/fleet-axi query <name> [--days N] [--since D] [--until D] [--by X]   spend, tool_failures, jev, gate, voyages (what the fleet_query tool answers)
//   bin/fleet-axi note <path> [--section X] [--full]  one vault note: frontmatter, headings, one section
//   bin/fleet-axi search [words] [--type T] [--status S] [--ship S] [--path P]   vault notes by words and frontmatter
//   bin/fleet-axi facts [subject] [--key K] [--history]   Alice's recorded facts (what the fact_get tool answers)
//   bin/fleet-axi setup hooks          opt in: show the summary at the start of Claude Code sessions in this repo
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { encode } from "@toon-format/toon";
import { fleetStatus, shipLog, shipTasks } from "../dashboard/lib/fleet-api.ts";
import { FLEET_QUERIES, fleetQuery, SPEND_BY } from "../dashboard/lib/fleet-query.ts";
import { factGet } from "../dashboard/lib/facts.ts";
import { ROOT } from "../dashboard/lib/paths.ts";
import { toolText, VIEWS } from "../dashboard/lib/tool-out.ts";
import { linkName, VAULT_FILTERS, vaultNextSteps, vaultTasksReport, type VaultFilter } from "../dashboard/lib/vault-tasks.ts";
import { searchVault } from "../dashboard/lib/vault-index.ts";
import { vaultNote } from "../dashboard/lib/vault-note.ts";

const COMMANDS = ["status", "ship", "vault", "next", "jev", "gate", "query", "note", "search", "facts", "setup"] as const;
const FLAGS: Record<string, string[]> = {
  status: ["--detail"],
  ship: ["--log"],
  vault: ["--id"],
  next: ["--id"],
  jev: ["--days"],
  gate: ["--days"],
  query: ["--days", "--since", "--until", "--by"],
  note: ["--section", "--full"],
  search: ["--type", "--status", "--ship", "--path", "--limit"],
  facts: ["--key", "--history"],
  setup: [],
  "": ["--brief"],
};
/** Flags that take no value. */
const SWITCHES = ["--detail", "--brief", "--full", "--history"];

const HELP: Record<string, string> = {
  "": `command: fleet-axi
summary: The fleet from any shell (read-only): ships, voyages, logs, vault tasks, Jev spend, tool gate, vault notes
usage: bin/fleet-axi [status|ship|vault|next|jev|gate|query|note|search|facts|setup] ...
commands[11]{command,what}:
  status,"ships, voyages, crews, spend today (--detail for crewmates and officers)"
  ship,"a ship's voyage tasks and log (bin/fleet-axi ship <id> [--log N])"
  vault,"vault tasks by filter: ready (default), open, in-progress, blocked, done, all; --id for one"
  next,"what is left on the active vault tasks: open Done-when steps, progress, closeable ones (--id for one)"
  jev,"Jev calls and spend per use, and the compaction advisor (--days N)"
  gate,tool gate decisions (--days N)
  query,"exact numbers from the fleet's records: spend (--by agent|model|day), tool_failures, jev, gate, voyages (--days N, or --since/--until YYYY-MM-DD)"
  note,"one vault note: frontmatter, summary, headings with sizes; --section <heading> for one section, --full for the body"
  search,"vault notes by words and frontmatter: --type, --status, --ship, --path (prefix or glob)"
  facts,"Alice's recorded facts (exact values that change, with source and date): bin/fleet-axi facts [subject] [--key k] [--history]"
  setup,"setup hooks: opt in to the summary at the start of Claude Code sessions in this repo"
flags[1]{flag,description}:
  --help,"show this help (also after a command)"
examples[3]:
  bin/fleet-axi
  bin/fleet-axi ship pochteca --log 15
  bin/fleet-axi vault blocked`,
  status: "command: fleet-axi status\nusage: bin/fleet-axi status [--detail]\nflags[2]{flag,description}:\n  --detail,add crewmates' activity and officers\n  --help,show this help\nexamples[2]:\n  bin/fleet-axi status\n  bin/fleet-axi status --detail",
  ship: "command: fleet-axi ship\nusage: bin/fleet-axi ship <id> [--log N]\nflags[2]{flag,default,description}:\n  --log,15,how many log lines\n  --help,,show this help\nexamples[2]:\n  bin/fleet-axi ship pochteca\n  bin/fleet-axi ship kinwork --log 40",
  vault: `command: fleet-axi vault\nusage: bin/fleet-axi vault [${VAULT_FILTERS.join("|")}] [--id <task>]\nflags[2]{flag,description}:\n  --id,one task's detail (what it waits on and blocks)\n  --help,show this help\nexamples[3]:\n  bin/fleet-axi vault\n  bin/fleet-axi vault in-progress\n  bin/fleet-axi vault --id fleet-observe-reviews`,
  next: "command: fleet-axi next\nusage: bin/fleet-axi next [--id <task>]\nsummary: Open Done-when steps of each open or in-progress vault task, so a task note need not be read whole\nflags[2]{flag,description}:\n  --id,only that task\n  --help,show this help\nexamples[2]:\n  bin/fleet-axi next\n  bin/fleet-axi next --id fleet-observe-reviews",
  jev: "command: fleet-axi jev\nusage: bin/fleet-axi jev [--days N]\nflags[2]{flag,default,description}:\n  --days,7,how far back\n  --help,,show this help\nexamples[2]:\n  bin/fleet-axi jev\n  bin/fleet-axi jev --days 30",
  gate: "command: fleet-axi gate\nusage: bin/fleet-axi gate [--days N]\nflags[2]{flag,default,description}:\n  --days,1,how far back\n  --help,,show this help\nexamples[2]:\n  bin/fleet-axi gate\n  bin/fleet-axi gate --days 7",
  query: `command: fleet-axi query\nusage: bin/fleet-axi query <${FLEET_QUERIES.join("|")}> [--days N] [--since D] [--until D] [--by ${SPEND_BY.join("|")}]\nsummary: Named read-only queries over the fleet's records; no SQL\nflags[5]{flag,default,description}:\n  --days,7,how far back from now (or from --until)\n  --since,,first day YYYY-MM-DD (UTC, inclusive) or ISO time; ignores --days\n  --until,,last day YYYY-MM-DD (UTC, inclusive) or ISO time\n  --by,agent,spend only: group by agent / model / day\n  --help,,show this help\nexamples[4]:\n  bin/fleet-axi query spend --days 7 --by agent\n  bin/fleet-axi query spend --since 2026-10-18 --until 2026-10-25 --by agent\n  bin/fleet-axi query tool_failures --days 7\n  bin/fleet-axi query voyages`,
  note: "command: fleet-axi note\nusage: bin/fleet-axi note <path> [--section <heading>] [--full]\nsummary: One vault note without reading the file; the body only when asked, cut at 12 KB\nflags[3]{flag,description}:\n  --section,one section by heading (any case)\n  --full,the whole body\n  --help,show this help\nexamples[3]:\n  bin/fleet-axi note fleet/plans/research/alice-memory-and-tools.md\n  bin/fleet-axi note fleet/plans/research/alice-memory-and-tools.md --section Phases\n  bin/fleet-axi note tasks/fleet-memory-m1-tools --full",
  search: "command: fleet-axi search\nusage: bin/fleet-axi search [words] [--type T] [--status S] [--ship S] [--path P] [--limit N]\nsummary: Vault notes by words (sections, with a snippet) and frontmatter; newest first without words\nflags[6]{flag,default,description}:\n  --type,,frontmatter type, e.g. Task, Plan\n  --status,,frontmatter status\n  --ship,,frontmatter ship\n  --path,,path prefix (tasks/) or glob (fleet/plans/**)\n  --limit,8,notes shown (max 25)\n  --help,,show this help\nexamples[3]:\n  bin/fleet-axi search jev --type Plan\n  bin/fleet-axi search --type Task --status in-progress\n  bin/fleet-axi search \"compaction advisor\" --path fleet/",
  facts: "command: fleet-axi facts\nusage: bin/fleet-axi facts [subject] [--key <key>] [--history]\nsummary: The fleet's recorded facts (hosts, models, owners, dates), current ones newest first, each with its source; nothing is ever deleted\nflags[3]{flag,description}:\n  --key,only that key\n  --history,with a subject and --key: the values it had before\n  --help,show this help\nexamples[3]:\n  bin/fleet-axi facts\n  bin/fleet-axi facts hub\n  bin/fleet-axi facts hub --key host --history",
  setup: "command: fleet-axi setup\nusage: bin/fleet-axi setup hooks\nsummary: Add a SessionStart hook to .claude/settings.local.json (gitignored) that prints bin/fleet-axi --brief; running it again changes nothing\nflags[1]{flag,description}:\n  --help,show this help\nexamples[1]:\n  bin/fleet-axi setup hooks",
};

const [cmd = "", ...rest] = process.argv.slice(2);

function fail(message: string, suggestion: string, code = 2): never {
  console.log(encode({ error: message, suggestion }));
  process.exit(code);
}

function flag(name: string): string | undefined {
  const i = rest.indexOf(name);
  return i >= 0 ? rest[i + 1] : undefined;
}

async function home(brief: boolean): Promise<void> {
  const s = (await fleetStatus(false)) as { message: string; needsCaptain?: unknown[] };
  const ready = vaultTasksReport("ready") as { tasks?: { id: string; title: string; priority: string }[]; message: string };
  const out: Record<string, unknown> = {
    ...(brief ? {} : { bin: "~/Workspace/agents/bin/fleet-axi", description: "The fleet from any shell (read-only)" }),
    fleet: s.message,
    waiting_on_captain: s.needsCaptain?.length ? s.needsCaptain.slice(0, 8) : "0 items",
    vault: ready.message,
    ready: ready.tasks?.length ? ready.tasks.slice(0, brief ? 5 : 8).map((t) => ({ id: t.id, priority: t.priority, title: t.title })) : "0 ready tasks",
    help: brief ? ["bin/fleet-axi --help"] : ["bin/fleet-axi status --detail", "bin/fleet-axi ship <id>", "bin/fleet-axi vault in-progress", "bin/fleet-axi next", "bin/fleet-axi jev", "bin/fleet-axi query spend --by agent", "bin/fleet-axi search <words>"],
  };
  console.log(encode(out));
}

/** Arguments that are not flags or flag values. */
function positional(): string[] {
  const out: string[] = [];
  for (let i = 0; i < rest.length; i++) {
    if (!rest[i]!.startsWith("--")) out.push(rest[i]!);
    else if (!SWITCHES.includes(rest[i]!)) i++;
  }
  return out;
}

async function main(): Promise<void> {
  if (cmd === "--version" || cmd === "-v" || cmd === "-V") return void console.log("1.0.0");
  if (cmd === "--help" || cmd === "-h" || rest.includes("--help")) {
    const h = HELP[cmd.startsWith("-") ? "" : cmd];
    if (h === undefined) fail(`unknown command ${cmd}`, `commands: ${COMMANDS.join(", ")} (bin/fleet-axi --help)`);
    return void console.log(h);
  }
  const key = cmd.startsWith("--") ? "" : cmd;
  if (key && !(COMMANDS as readonly string[]).includes(key)) fail(`unknown command ${cmd}`, `commands: ${COMMANDS.join(", ")} (bin/fleet-axi --help)`);
  const args = key ? rest : [cmd, ...rest].filter(Boolean);
  for (let i = 0; i < args.length; i++) {
    const a = args[i]!;
    if (!a.startsWith("--")) continue;
    if (!(FLAGS[key] ?? []).includes(a)) fail(`unknown flag ${a}${key ? ` for ${key}` : ""}`, `valid flags: ${[...(FLAGS[key] ?? []), "--help"].join(", ")}`);
    if (!SWITCHES.includes(a)) i++;
  }

  if (!key) return home(args.includes("--brief"));
  if (key === "status") return void console.log(toolText(await fleetStatus(rest.includes("--detail")), VIEWS.fleet_status));
  if (key === "ship") {
    const id = rest.find((a) => !a.startsWith("--") && a !== flag("--log"));
    if (!id) fail("ship needs a ship id", "bin/fleet-axi ship <id> (bin/fleet-axi status lists the ships)");
    const n = Math.min(200, Math.max(1, Number(flag("--log") ?? 15) || 15));
    console.log(toolText(await shipTasks(id), VIEWS.ship_tasks));
    console.log(toolText(shipLog(id, n), VIEWS.ship_log));
    return;
  }
  if (key === "vault") {
    const id = flag("--id") ?? "";
    const filter = rest.find((a) => !a.startsWith("--") && a !== id) ?? "ready";
    if (!(VAULT_FILTERS as string[]).includes(filter)) fail(`unknown filter ${filter}`, `filters: ${VAULT_FILTERS.join(", ")}`);
    return void console.log(toolText(vaultTasksReport(filter as VaultFilter, id), VIEWS.vault_tasks));
  }
  if (key === "next") {
    const id = linkName(flag("--id") ?? "");
    const r = vaultNextSteps();
    if (!id) return void console.log(encode({ result: r.message, tasks: r.tasks, ...(r.unreadable ? { unreadable: r.unreadable } : {}) }));
    const t = r.tasks.find((x) => x.id === id);
    if (!t) fail(`no active vault task ${id}`, `active: ${r.tasks.map((x) => x.id).join(", ") || "none"} (bin/fleet-axi vault all lists every task)`);
    return void console.log(encode(t));
  }
  if (key === "jev" || key === "gate" || key === "query") {
    const name = key === "query" ? positional()[0] : key;
    if (!name) fail("query needs a name", `bin/fleet-axi query <${FLEET_QUERIES.join("|")}>`);
    const days = flag("--days") === undefined ? undefined : Math.max(1, Number(flag("--days")) || 7);
    const r = fleetQuery(name, { days: days ?? (key === "gate" ? 1 : 7), by: flag("--by"), since: flag("--since"), until: flag("--until") });
    if (!r.ok) fail(r.message, `bin/fleet-axi query --help (queries: ${FLEET_QUERIES.join(", ")})`);
    return void console.log(toolText(r, VIEWS.fleet_query));
  }
  if (key === "note") {
    const path = positional()[0];
    if (!path) fail("note needs a path", "bin/fleet-axi note <path> (bin/fleet-axi search finds notes)");
    const r = vaultNote(path, { section: flag("--section"), full: rest.includes("--full") });
    if (!r.ok) fail(r.message, "bin/fleet-axi search <words> finds the note; bin/fleet-axi note <path> lists its headings");
    return void console.log(toolText(r, VIEWS.vault_note));
  }
  if (key === "search") {
    const r = searchVault({ query: positional().join(" ") || undefined, type: flag("--type"), status: flag("--status"), ship: flag("--ship"), path: flag("--path"), limit: Number(flag("--limit")) || undefined });
    if (!r.ok) fail(r.message, "bin/fleet-axi search --help");
    return void console.log(toolText(r, VIEWS.vault_search));
  }
  if (key === "facts") {
    const r = factGet({ subject: positional()[0], key: flag("--key"), history: rest.includes("--history") });
    if (!r.ok) fail(r.message, "bin/fleet-axi facts --help");
    return void console.log(toolText(r, VIEWS.fact_get));
  }
  if (key === "setup") {
    if (rest[0] !== "hooks") fail("setup takes hooks", "bin/fleet-axi setup hooks");
    const path = join(ROOT, ".claude", "settings.local.json");
    const command = `${join(ROOT, "bin", "fleet-axi")} --brief`;
    let cfg: { hooks?: { SessionStart?: { hooks?: { type: string; command: string }[] }[] } } = {};
    if (existsSync(path)) {
      try {
        cfg = JSON.parse(readFileSync(path, "utf8"));
      } catch {
        fail(`${path} is not valid JSON`, "fix the file, then run setup hooks again", 1);
      }
    }
    const starts = (cfg.hooks ??= {}).SessionStart ??= [];
    if (starts.some((s) => s.hooks?.some((h) => h.command.includes("bin/fleet-axi")))) return void console.log(encode({ ok: "already set up (no change)", file: path }));
    starts.push({ hooks: [{ type: "command", command }] });
    writeFileSync(path, `${JSON.stringify(cfg, null, 2)}\n`, "utf8");
    return void console.log(encode({ ok: "SessionStart hook added", file: path, command, next: "start a new Claude Code session in this repo to see the fleet summary first" }));
  }
}

await main();
process.exit(0);
