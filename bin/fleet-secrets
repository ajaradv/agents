#!/bin/bash
# fleet-secrets - the fleet's provider keys as KEY=value lines, read with the
# 1Password service account (token in the login Keychain, see bin/fleet-op-token)
# from the references in fleet/home/.env.op, through 1Password's SDK. Works while
# the 1Password app is locked and never prompts. bin/launch, the node, and the
# scripts read keys only from here once .env.op exists (the fleet/home/.env
# mount asks the 1Password app).
#
# Refuses to write to a terminal: keys only ever go into a pipe. Prints nothing
# (exit 0) when no token or no fleet/home/.env.op is set up.
#
# Usage: bin/fleet-secrets | <reader>
set -uo pipefail

if [ -t 1 ]; then
  echo "error: fleet-secrets prints secrets and only writes into a pipe" >&2
  echo "suggestion: check the setup with bin/fleet-op-token instead" >&2
  exit 2
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# 1Password's SDK with the service account token (dashboard/lib/op-sdk.ts), not
# the op CLI: op started from the node or the dashboard (launchd services) hung
# before its first log line (2026-10-18). Prints nothing without a token or refs.
command -v bun >/dev/null 2>&1 || exit 0
exec bun "$ROOT/dashboard/lib/op-sdk.ts"
