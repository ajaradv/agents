#!/usr/bin/env bash
# fleet-secrets - the fleet's provider keys as KEY=value lines, read with the
# 1Password service account (token in the login Keychain, see bin/fleet-op-token)
# from the references in fleet/home/.env.op. Works while the 1Password app is
# locked. bin/launch and the node read this first and fall back to the
# fleet/home/.env mount.
#
# Refuses to write to a terminal: keys only ever go into a pipe. Prints nothing
# (exit 0) when no token or no fleet/home/.env.op is set up.
#
# Usage: bin/fleet-secrets | <reader>
set -uo pipefail

if [ -t 1 ]; then
  echo "error: fleet-secrets prints secrets and only writes into a pipe" >&2
  echo "suggestion: check the setup with bin/fleet-op-token instead" >&2
  exit 2
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REFS="${FLEET_OP_ENV_FILE:-$ROOT/fleet/home/.env.op}"
[ -f "$REFS" ] || exit 0
command -v op >/dev/null 2>&1 || exit 0
TOKEN="$(security find-generic-password -a fleet -s op-service-account -w 2>/dev/null || true)"
[ -n "$TOKEN" ] || exit 0
OP_SERVICE_ACCOUNT_TOKEN="$TOKEN" op inject -i "$REFS" 2>/dev/null
