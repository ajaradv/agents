#!/bin/sh
# cdt - drive the VM's Chromium interactively through chrome-devtools-axi (R4e, designers).
# Starts a headless Chromium with remote debugging on 127.0.0.1:9222 the first time
# (trusting only Gondolin's CA for HTTPS, like `shot`), then runs
# `chrome-devtools-axi "$@"` against it.
#
#   cdt open http://localhost:5173      cdt snapshot      cdt click @g1:3
#   cdt fill @g1:5 "hello"              cdt screenshot /cache/shots/x.png
#   cdt --help                          (chrome-devtools-axi's own help)
set -eu
PORT=9222
if ! wget -q -O /dev/null "http://127.0.0.1:$PORT/json/version" 2>/dev/null; then
  SPKI="$(node -e 'const c=require("crypto"),f=require("fs");try{const k=new c.X509Certificate(f.readFileSync(process.env.NODE_EXTRA_CA_CERTS||"/etc/gondolin/mitm/ca.crt")).publicKey.export({type:"spki",format:"der"});process.stdout.write(c.createHash("sha256").update(k).digest("base64"))}catch{}')"
  mkdir -p /tmp/cdt-profile
  chromium --headless=new --no-sandbox --disable-gpu --disable-dev-shm-usage \
    --remote-debugging-address=127.0.0.1 --remote-debugging-port=$PORT \
    --user-data-dir=/tmp/cdt-profile ${SPKI:+--ignore-certificate-errors-spki-list=$SPKI} \
    about:blank >/tmp/cdt-chromium.log 2>&1 &
  i=0
  until wget -q -O /dev/null "http://127.0.0.1:$PORT/json/version" 2>/dev/null; do
    i=$((i + 1)); [ "$i" -gt 50 ] && { echo "error: Chromium did not start (see /tmp/cdt-chromium.log)"; exit 1; }
    sleep 0.2
  done
fi
export CHROME_DEVTOOLS_AXI_BROWSER_URL="http://127.0.0.1:$PORT"
exec chrome-devtools-axi "$@"
