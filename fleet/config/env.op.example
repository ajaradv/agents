# 1Password CLI secret references for: op run --env-file=… -- bin/launch …
# Copy to fleet/home/.env.op (gitignored). Replace vault/item/field paths with yours.
# Docs: https://developer.1password.com/docs/cli/secret-reference/
#
# Sign in first: op signin
# Test: op run --env-file=fleet/home/.env.op -- printenv TYPESAFE_API_KEY

TYPESAFE_API_KEY=op://Fleet/Jev/credential
DEEPSEEK_API_KEY=op://Fleet/DeepSeek/credential
OPENROUTER_API_KEY=op://Fleet/OpenRouter/credential
HF_API_KEY=op://Fleet/HuggingFace/credential

# Pi primaries (Alice, Firstmate) use pi-cursor-sdk — not the same as Cursor CLI login for crew panes
CURSOR_API_KEY=op://Fleet/Cursor SDK/credential

# Optional: Pi native Anthropic (not Claude Code subscription panes): add an
# ANTHROPIC_API_KEY line like the ones above. op inject resolves references even
# in comments, so a commented-out reference to a missing item breaks the file.
# Gemini: the free tier for free lanes and evaluations (node only), and the paid plan for agents on google/ models.
GEMINI_FREE_API_KEY=op://Fleet/GEMINI_FREE_API_KEY/credential
GEMINI_API_KEY=op://Fleet/GEMINI_API_KEY/credential
