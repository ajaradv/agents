# Names only — copy into 1Password Environment agents-fleet. Never commit values.
# Mount or op run into fleet/home/.env on each host that needs them.

TYPESAFE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
HF_API_KEY=
